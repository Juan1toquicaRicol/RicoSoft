generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                             String                          @id @default(uuid()) @db.UniqueIdentifier
  nombre                         String                          @db.VarChar(255)
  subdomain                      String                          @unique @db.VarChar(255)
  siesaCiaId                     Int?                            @unique
  /// Dominio de correo corporativo (p. ej. "ricol.com.co") que determina a
  /// qué tenant pertenece un usuario que se autoregistra. Único: dos tenants
  /// no pueden compartir el mismo dominio. Null = el tenant no acepta
  /// autoregistro público por dominio (p. ej. el tenant demo).
  dominioCorporativo             String?                         @unique @db.VarChar(255)
  /// Si es false, nadie puede loguearse/registrarse/seleccionar este tenant,
  /// aunque tenga cuenta o membresía activa ahí.
  activo                         Boolean                         @default(true)
  createdAt                      DateTime                        @default(now())
  auditorias                     Auditoria[]
  colaboradores                  Colaborador[]
  configuracionInventario        ConfiguracionInventario?
  configuracionComercial         ConfiguracionComercial?
  consecutivosImportacion        ConsecutivoImportacion[]
  creditos                       CreditoCliente[]
  departamentos                  Departamento[]
  tomasFisicas                   TomaFisica[]
  planesProduccion               PlanProduccion[]
  gestionesLiquidacion           GestionLiquidacion[]
  despachos                      Despacho[]
  empleados                      Empleado[]
  cargosColaborador              CargoColaborador[]
  catalogosSeguridadSocial       CatalogoSeguridadSocial[]
  empleadosDetalle               EmpleadoDetalle[]
  empleadosFamiliares            EmpleadoFamiliar[]
  empleadosEstudios              EmpleadoEstudio[]
  empleadosDocumentos            EmpleadoDocumento[]
  facturas                       Factura[]
  faltas                         FaltaStrike[]
  modulos                        Modulo[]
  notificaciones                 Notificacion[]
  pagos                          Pago[]
  permisosLaborales              PermisoLaboral[]
  proveedores                    Proveedor[]
  proyecciones                   ProyeccionMensual[]
  analisisGuardados              AnalisisGuardado[]
  seguimientosOportunidad        OportunidadSeguimiento[]
  reglas                         ReglaEnrutamiento[]
  roles                          Rol[]
  servicios                      ServicioSuscripcion[]
  solicitudesCompra              SolicitudCompra[]
  users                          User[]
  membresias                     Membresia[]
  ordenesCompraIntl              OrdenCompraIntl[]
  lotesImportacion               LoteImportacion[]
  hitosLoteImportacion           LoteImportacionHito[]
  documentosLoteImportacion      LoteImportacionDocumento[]
  expedientesAduaneros           ExpedienteAduanero[]
  costeosImportacion             CosteoImportacionDetalle[]
  actividadesImportacion         ImportacionActividad[]
  novedadesImportacion           ImportacionNovedad[]
  pagosImportacion               ImportacionPago[]
  documentosOrdenCompraIntl      OrdenCompraIntlDocumento[]
  clasificacionesFuncionalesItem ClasificacionFuncionalItem[]
  itemClasificacionesAsignadas   ItemClasificacionAsignada[]
  cotizacionesProveedor          CotizacionProveedor[]
  permisosCatalogo               Permiso[]
  sincronizacionesSiesa          SincronizacionSiesaLog[]
  inboxItems                     InboxItem[]
  objetivos                      Objetivo[]
  fuentesBiometricas             FuenteBiometrica[]
  empleadosBiometricos           EmpleadoBiometrico[]
  marcacionesBiometricas         MarcacionBiometrica[]
  sincronizacionesBiometrico     SincronizacionBiometricoLog[]
  perfilesFuncionales            PerfilFuncional[]
  usuarioPerfilesFuncionales     UsuarioPerfilFuncional[]
  indicadoresCreditoCliente      IndicadorCreditoCliente[]
  reglasDestinatarios            ReglaDestinatarios[]
  requisitosProveedorImportacion RequisitoProveedorImportacion[]
  correosImportacion             ImportacionCorreo[]
  excepcionesImportacion         ImportacionExcepcion[]
  catalogosValor                 CatalogoValor[]
  plantillasNotificacion         PlantillaNotificacion[]
  publicaciones                  Publicacion[]
  proformas                      Proforma[]
  cotizacionesComerciales        Cotizacion[]
  pedidosComerciales             PedidoComercial[]
}

model User {
  id                               String                     @id @default(uuid()) @db.UniqueIdentifier
  tenantId                         String                     @db.UniqueIdentifier
  email                            String                     @unique @db.VarChar(255)
  passwordHash                     String                     @db.Text
  /// Nombre completo (compatibilidad): se deriva de nombres + apellidos cuando
  /// ambos existen; en cuentas antiguas es el único dato y no se separa solo.
  nombre                           String                     @db.VarChar(255)
  /// Opcionales: NULL = cuenta pendiente de completar. Ver lib/nombre-persona.ts.
  nombres                          String?                    @db.VarChar(255)
  apellidos                        String?                    @db.VarChar(255)
  telefono                         String?                    @db.VarChar(50)
  rol                              String?                    @default("COLABORADOR") @db.VarChar(50)
  createdAt                        DateTime                   @default(now())
  activo                           Boolean                    @default(true)
  colaboradorId                    String?                    @db.UniqueIdentifier
  departamentoId                   String?                    @db.UniqueIdentifier
  isSuperadmin                     Boolean                    @default(false)
  lastLoginAt                      DateTime?
  rolId                            String?                    @db.UniqueIdentifier
  /// Se incluye en el JWT al iniciar sesión; se incrementa al cambiar la
  /// contraseña para invalidar de inmediato cualquier token emitido antes
  /// (robado o de otra sesión), sin esperar a que expire por tiempo.
  tokenVersion                     Int                        @default(0)
  /// Verificación del correo en el autoregistro (REGISTRO_VERIFICACION_CORREO_ENABLED).
  /// emailVerificacionPendiente=true: la cuenta se autoregistró con la verificación
  /// activa y aún no escribió el código; mientras tanto no se puede activar.
  /// Las cuentas existentes y las creadas por un administrador quedan en false/NULL.
  emailVerificacionPendiente       Boolean                    @default(false)
  emailVerificadoAt                DateTime?
  codigosVerificacionCorreo        CodigoVerificacionCorreo[]
  permisosDirectos                 PermisoUsuario[]
  membresias                       Membresia[]
  solicitudesResueltas             SolicitudCompra[]          @relation("SolicitudResueltaPor")
  solicitudesCreadas               SolicitudCompra[]          @relation("SolicitudSolicitante")
  solicitudesRecepcionConfirmada   SolicitudCompra[]          @relation("SolicitudRecepcionConfirmadaPor")
  notificaciones                   Notificacion[]             @relation("NotificacionDestinatario")
  facturasComoResponsable          Factura[]                  @relation("FacturaResponsable")
  serviciosComoResponsable         ServicioSuscripcion[]      @relation("ServicioResponsable")
  pagosRegistrados                 Pago[]                     @relation("PagoRegistradoPor")
  ordenesCompraIntlComoResponsable OrdenCompraIntl[]          @relation("OrdenCompraIntlResponsable")
  costeosImportacionLiquidados     CosteoImportacionDetalle[] @relation("CosteoLiquidadoPor")
  cotizacionesProveedorSubidas     CotizacionProveedor[]      @relation("CotizacionProveedorSubidaPor")
  sincronizacionesSiesaIniciadas   SincronizacionSiesaLog[]
  inboxItemsAsignados              InboxItem[]                @relation("InboxItemAsignado")
  inboxItemsResueltos              InboxItem[]                @relation("InboxItemResueltoPor")
  excepcionesImportacionResueltas  ImportacionExcepcion[]     @relation("ImportacionExcepcionResueltoPor")
  perfilesFuncionales              UsuarioPerfilFuncional[]
  analisisGuardados                AnalisisGuardado[]
  publicacionesCreadas             Publicacion[]              @relation("PublicacionAutor")
  proformasCreadas                 Proforma[]
  cotizacionesComercialesCreadas   Cotizacion[]
  pedidosComercialesCreados        PedidoComercial[]
  colaborador                      Colaborador?               @relation(fields: [colaboradorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departamento                     Departamento?              @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolRel                           Rol?                       @relation(fields: [rolId], references: [id])
  tenant                           Tenant                     @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@index([tenantId, activo])
  @@index([tenantId, email])
}

/// Código de 6 dígitos enviado al correo en el autoregistro. Nunca se guarda el
/// código en claro: codigoHash = HMAC-SHA256. Vence (expiraEn), sirve una sola vez
/// (usadoEn) y admite un número máximo de intentos. Solo el más reciente de cada
/// usuario es válido. Ver modules/auth/verificacion-correo.service.ts.
model CodigoVerificacionCorreo {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  userId     String    @db.UniqueIdentifier
  codigoHash String    @db.VarChar(64)
  expiraEn   DateTime
  intentos   Int       @default(0)
  usadoEn    DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt])
}

/// tenantId = NULL significa alcance GENERAL (disponible para asignar en
/// cualquier tenant); con valor = exclusivo de esa empresa. Ver comentario
/// equivalente en Departamento.
model Rol {
  id          String      @id @default(uuid()) @db.UniqueIdentifier
  tenantId    String?     @db.UniqueIdentifier
  nombre      String      @db.VarChar(100)
  descripcion String?     @db.VarChar(255)
  esSistema   Boolean     @default(false)
  activo      Boolean     @default(true)
  permisos    String      @default("[]") @db.Text
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  users       User[]
  membresias  Membresia[]

  @@index([tenantId])
}

/// Catálogo de permisos administrable desde Administración Global. Los ~70
/// permisos base del sistema (esSistema=true) se siembran automáticamente la
/// primera vez que un tenant consulta el catálogo, a partir de
/// PERMISOS_SISTEMA (server/src/lib/permissions.ts) — su código nunca se
/// puede editar ni el registro eliminarse, solo nombre/descripción/
/// módulo/activo. Un permiso creado aquí por un tenant (esSistema=false)
/// queda disponible para asignar a Roles igual que los del sistema, PERO
/// nada lo hace cumplir automáticamente: un permiso solo tiene efecto real
/// una vez que algún endpoint llama requirePermission("ese.codigo") — este
/// catálogo es el registro/asignación, no un motor de autorización genérico.
model Permiso {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId    String   @db.UniqueIdentifier
  codigo      String   @db.VarChar(150)
  nombre      String   @db.VarChar(255)
  descripcion String?  @db.Text
  modulo      String   @db.VarChar(100)
  esSistema   Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, codigo])
  @@index([tenantId])
}

model PermisoUsuario {
  id        String  @id @default(uuid()) @db.UniqueIdentifier
  userId    String  @db.UniqueIdentifier
  permisoId String  @db.VarChar(100)
  concedido Boolean
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Da acceso a un usuario a un tenant adicional al "hogar" (User.tenantId),
/// para las personas que trabajan en más de una empresa del grupo (Ricol,
/// Flexipack, Green Solutions). El rol/isSuperadmin/departamento de cada
/// membresía aplican solo dentro de ese tenant; no hereda permisos directos
/// (PermisoUsuario) del tenant hogar. Al loguearse, si el usuario tiene su
/// tenant hogar + 1 o más membresías activas, el frontend pide elegir con
/// cuál empresa entrar antes de emitir el JWT final.
model Membresia {
  id             String        @id @default(uuid()) @db.UniqueIdentifier
  userId         String        @db.UniqueIdentifier
  tenantId       String        @db.UniqueIdentifier
  rolId          String?       @db.UniqueIdentifier
  isSuperadmin   Boolean       @default(false)
  departamentoId String?       @db.UniqueIdentifier
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolRel         Rol?          @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Auditoria {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId        String   @db.UniqueIdentifier
  /// Sin FK ni relación a propósito (inmutabilidad del historial, ISO 27001
  /// A.12.4): al borrar al usuario la fila NO se modifica; el actor se resuelve
  /// con lib/auditoria-usuarios.ts (usuario vigente o snapshot del evento
  /// USUARIO_ELIMINADO).
  usuarioId       String?  @db.UniqueIdentifier
  usuarioAfectado String?  @db.VarChar(255)
  accion          String   @db.VarChar(100)
  detalle         String   @db.Text
  /// Nombre del modelo afectado (p. ej. "User", "Rol"), para poder filtrar
  /// y para saber qué representan datosAnteriores/datosNuevos.
  entidadTipo     String?  @db.VarChar(50)
  entidadId       String?  @db.VarChar(100)
  /// JSON con los campos que cambiaron (antes/después), no el registro
  /// completo. Opcional: los eventos que no representan un cambio de campo
  /// (p. ej. LOGIN) lo dejan en null y siguen usando `detalle` como resumen.
  datosAnteriores String?  @db.Text
  datosNuevos     String?  @db.Text
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@index([tenantId])
  @@index([usuarioId])
}

/// Notificación in-app dirigida a un usuario concreto (p. ej. "tienes una
/// solicitud de compra pendiente de aprobar"). No envía correo ni push: es
/// el centro de notificaciones dentro de RicoSoft.
model Notificacion {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId    String   @db.UniqueIdentifier
  usuarioId   String   @db.UniqueIdentifier
  tipo        String   @db.VarChar(50)
  titulo      String   @db.VarChar(255)
  mensaje     String   @db.Text
  /// Ruta del frontend a la que navegar al hacer click (p. ej. "/facturas").
  enlace      String?  @db.VarChar(500)
  /// Fase 5.4.1: junto con tenantId+usuarioId+tipo, forman la clave de
  /// deduplicación de crearNotificacion() — "este usuario ya fue notificado
  /// de este evento para esta entidad/ciclo concreto" (ej.
  /// entidadTipo="ServicioSuscripcion", entidadId="<servicioId>:<fecha>"),
  /// sin necesitar parsear `enlace` (texto libre). Sigue habiendo un índice
  /// único FILTRADO sobre estas 5 columnas (migración
  /// 20260908160000_notificacion_dedupe_entidad,
  /// [Notificacion_dedupe_entidad_uq]) que Prisma no puede expresar con
  /// `@@unique` porque su condición WHERE excluye las filas con
  /// entidadTipo/entidadId NULL — así las notificaciones sin entidad (todos
  /// los emisores anteriores a esta fase) NUNCA quedan sujetas a ninguna
  /// restricción de unicidad.
  entidadTipo String?  @db.VarChar(50)
  entidadId   String?  @db.VarChar(100)
  leida       Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  usuario     User     @relation("NotificacionDestinatario", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, usuarioId, leida])
  @@index([usuarioId, createdAt])
}

/// tenantId = NULL significa alcance GENERAL: visible/usable por todos los
/// tenants, un único registro (no se duplica por empresa). tenantId con
/// valor = exclusivo de esa empresa. Mismo mecanismo que Rol y Modulo, para
/// no tener tres formas distintas de expresar lo mismo.
model Departamento {
  id                  String            @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String?           @db.UniqueIdentifier
  nombre              String            @db.VarChar(255)
  activo              Boolean           @default(true)
  esSistemas          Boolean           @default(false)
  colaboradores       Colaborador[]
  cargosColaborador   CargoColaborador[]
  modulos             Modulo[]
  usuarios            User[]
  membresias          Membresia[]
  proveedores         Proveedor[]
  perfilesFuncionales PerfilFuncional[]
  tenant              Tenant?           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Perfil funcional dentro de un Departamento ("Tesorería", "Recepción de
/// Facturas", "Jefe de Contabilidad") — Fase 5 (perfiles + distribución de
/// alertas). Deliberadamente SEPARADO de Rol: un Perfil no otorga ningún
/// permiso de seguridad, solo agrupa personas para poder dirigirles avisos
/// operativos ("todo Tesorería", "el jefe de esta área") sin acoplar eso al
/// sistema de permisos. A diferencia de Departamento/Rol/Modulo, no tiene
/// alcance GENERAL todavía: siempre pertenece a un tenant concreto (ver
/// razonamiento en la auditoría de Fase 5.1) — si más adelante hace falta
/// compartirlo entre tenants del mismo grupo, se migra al mismo patrón
/// tenantId-nullable que ya usan esos tres modelos.
model PerfilFuncional {
  id             String                   @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String                   @db.UniqueIdentifier
  departamentoId String                   @db.UniqueIdentifier
  nombre         String                   @db.VarChar(255)
  /// Marca este perfil como "jefe" de su Departamento — el motor de
  /// destinatarios (Fase 5.3) resolverá el destinatario JEFE_AREA de un área
  /// como "todos los usuarios que tengan un perfil de esa área con
  /// esJefeDeArea=true", sin necesitar un campo nuevo en Departamento.
  esJefeDeArea   Boolean                  @default(false)
  activo         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  departamento   Departamento             @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios       UsuarioPerfilFuncional[]

  @@unique([tenantId, departamentoId, nombre])
  @@index([tenantId])
  @@index([departamentoId])
}

/// Asignación de un usuario a un Perfil funcional — many-to-many a propósito
/// (a diferencia de User.departamentoId/rolId, que son 1-a-1): una misma
/// persona puede cubrir varios perfiles a la vez (ej. Tesorería + Recepción
/// de Facturas), justo el caso que Rol/Departamento no permiten hoy.
model UsuarioPerfilFuncional {
  id        String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String          @db.UniqueIdentifier
  userId    String          @db.UniqueIdentifier
  perfilId  String          @db.UniqueIdentifier
  createdAt DateTime        @default(now())
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  user      User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  perfil    PerfilFuncional @relation(fields: [perfilId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, perfilId])
  @@index([tenantId])
  @@index([perfilId])
}

/// Módulos principales de la aplicación (Facturas, Servicios, etc.), agrupables
/// por Departamento desde Configuración. clave identifica el módulo de forma
/// estable independientemente del departamento al que esté asignado.
/// tenantId = NULL significa alcance GENERAL (visible para todos los
/// tenants); con valor = exclusivo de esa empresa. Ver comentario
/// equivalente en Departamento. El @@unique([tenantId, clave]) ya se
/// comporta correctamente con NULL sin cambios: SQL Server compara la tupla
/// completa en un índice compuesto, así que solo permite UN módulo general
/// por clave (NULL, "compras") a la vez que sigue permitiendo esa misma
/// clave una vez por cada tenant específico — no hace falta un índice
/// filtrado adicional aquí.
model Modulo {
  id             String        @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String?       @db.UniqueIdentifier
  clave          String        @db.VarChar(100)
  nombre         String        @db.VarChar(255)
  ruta           String        @db.VarChar(255)
  icono          String        @db.VarChar(50)
  /// Código de PERMISOS_SISTEMA (p. ej. "facturas.ver") requerido para que
  /// este módulo aparezca en el sidebar de un usuario y sea considerado
  /// "accesible". NULL = visible para cualquier usuario autenticado del
  /// tenant (Dashboard, Bandeja). No es un sistema de permisos paralelo: es
  /// un puntero de texto al mismo catálogo que ya usa Rol.permisos.
  permisoClave   String?       @db.VarChar(150)
  departamentoId String?       @db.UniqueIdentifier
  activo         Boolean       @default(true)
  orden          Int           @default(0)
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, clave])
  @@index([tenantId])
  @@index([departamentoId])
}

/// Catálogo maestro de proveedores, compartido entre Facturas y
/// Servicios/Suscripciones (antes cada uno guardaba "proveedor" como texto
/// libre, duplicado e inconsistente). El nit es único por tenant para evitar
/// registrar el mismo proveedor dos veces con nombres ligeramente distintos.
model Proveedor {
  id                       String                          @id @default(uuid()) @db.UniqueIdentifier
  tenantId                 String                          @db.UniqueIdentifier
  nombre                   String                          @db.VarChar(255)
  nit                      String                          @db.VarChar(50)
  contacto                 String?                         @db.VarChar(255)
  telefono                 String?                         @db.VarChar(50)
  email                    String?                         @db.VarChar(255)
  /// Plazo/términos de pago negociados con el proveedor (texto libre, ej.
  /// "30 días crédito", "Contado"). Se copia como snapshot a Factura al
  /// recibir una factura de este proveedor, pero puede editarse ahí sin
  /// afectar este valor de catálogo.
  condicionesPago          String?                         @db.VarChar(500)
  /// Datos de dónde/cómo pagarle a este proveedor (banco, número de cuenta,
  /// tipo de cuenta, beneficiario). Texto libre porque varía mucho entre
  /// proveedores nacionales/extranjeros y no hay un formato único que valga
  /// la pena estructurar todavía.
  datosPago                String?                         @db.Text
  /// Departamento dueño de este proveedor (p. ej. un proveedor de insumos de
  /// Producción no debería ofrecerse al crear una SC de Comercial). Null =
  /// proveedor "general", visible para cualquier departamento — así todos los
  /// proveedores existentes antes de este campo siguen apareciendo en todas
  /// partes sin necesidad de migrarlos uno por uno.
  departamentoId           String?                         @db.UniqueIdentifier
  /// País de origen del proveedor (mismo catálogo que
  /// OrdenCompraIntl.paisOrigen — PAISES_VALIDOS en proveedores.controller.ts).
  /// Null = no configurado todavía; no bloquea nada del proveedor, solo
  /// alimenta el país que se sugiere/hereda al registrar una nueva orden de
  /// compra internacional para este proveedor.
  paisOrigen               String?                         @db.VarChar(100)
  /// Materiales que este proveedor usualmente importa (texto libre por
  /// etiqueta, ej. "Telas", "Hilos") — JSON array de strings, igual patrón
  /// que ImportacionExcepcion.candidatos. Solo informativo/de referencia
  /// rápida en la ficha del proveedor, no valida contra ningún catálogo.
  materialesHabituales     String?                         @db.Text
  /// Identidad técnica estable del tercero en Siesa (t200_mm_terceros.f200_rowid),
  /// independiente del NIT — el NIT es un dato de negocio que puede
  /// corregirse en Siesa; este campo es lo que evita crear un proveedor
  /// duplicado cuando eso pasa. Null para proveedores creados manualmente en
  /// RicoSoft, o para proveedores sincronizados antes de esta columna
  /// existir y que todavía no pasaron por el backfill (ver siesa-sync.service.ts).
  siesaTerceroRowId        Int?
  /// "SIESA" si el registro fue creado/vinculado por la sincronización,
  /// "MANUAL" si lo creó un usuario desde RicoSoft. Nunca cambia de MANUAL a
  /// SIESA automáticamente — solo el backfill explícito lo hace, con
  /// vinculación inequívoca.
  origen                   String                          @default("MANUAL") @db.VarChar(20)
  ultimaSincronizacion     DateTime?
  /// Si un usuario edita el nombre a mano, se pone en true y la
  /// sincronización deja de sobrescribirlo — evita que un dato corregido a
  /// mano en RicoSoft se revierta silenciosamente en el siguiente sync.
  nombreEditadoManualmente Boolean                         @default(false)
  activo                   Boolean                         @default(true)
  createdAt                DateTime                        @default(now())
  tenant                   Tenant                          @relation(fields: [tenantId], references: [id])
  departamento             Departamento?                   @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facturas                 Factura[]
  servicios                ServicioSuscripcion[]
  solicitudesCompra        SolicitudCompra[]
  cotizaciones             CotizacionProveedor[]
  ordenesCompraIntl        OrdenCompraIntl[]
  requisitosImportacion    RequisitoProveedorImportacion[]
  correosImportacion       ImportacionCorreo[]

  @@unique([tenantId, nit])
  @@index([tenantId])
  @@index([tenantId, departamentoId])
  @@index([tenantId, siesaTerceroRowId])
}

/// Historial de corridas de sincronización de proveedores desde Siesa. Vive
/// aparte de Auditoria porque necesita contadores estructurados y estado
/// consultable (para polling desde la UI), no solo un texto libre — ver
/// siesa-sync.service.ts. Cada corrida queda asociada a un solo tenant/ciaId,
/// nunca mezcla varios.
model SincronizacionSiesaLog {
  id                    String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId              String    @db.UniqueIdentifier
  ciaId                 Int
  /// EN_COLA | EN_CURSO | COMPLETADO | FALLIDO | CANCELADO
  estado                String    @default("EN_COLA") @db.VarChar(20)
  /// Nullable a propósito: si el usuario que inició la sincronización se
  /// borra (ver eliminarUsuario con forzado), el historial de la corrida se
  /// conserva y solo se desvincula la FK.
  iniciadoPorId         String?   @db.UniqueIdentifier
  iniciadoEn            DateTime  @default(now())
  finalizadoEn          DateTime?
  leidos                Int       @default(0)
  creados               Int       @default(0)
  actualizados          Int       @default(0)
  desactivados          Int       @default(0)
  sinCambios            Int       @default(0)
  erroresCount          Int       @default(0)
  /// JSON con el detalle de errores por fila (mismo shape que ya devolvía el
  /// endpoint síncrono: [{ nit, mensaje }]).
  errores               String?   @db.Text
  mensajeError          String?   @db.Text
  /// Bandera cooperativa: el bucle de sincronización la revisa
  /// periódicamente y se detiene si está en true, en vez de matar el proceso.
  cancelacionSolicitada Boolean   @default(false)
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  iniciadoPor           User?     @relation(fields: [iniciadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, estado])
  @@index([tenantId, iniciadoEn])
}

model Colaborador {
  id              String        @id @default(uuid()) @db.UniqueIdentifier
  tenantId        String        @db.UniqueIdentifier
  departamentoId  String?       @db.UniqueIdentifier
  numero_empleado String        @db.VarChar(50)
  nombre          String        @db.VarChar(255)
  apellido        String        @db.VarChar(255)
  departamento    Departamento? @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  users           User[]

  @@index([tenantId])
}

model Factura {
  id                     String               @id @default(uuid()) @db.UniqueIdentifier
  tenantId               String               @db.UniqueIdentifier
  empresaId              String               @db.VarChar(10)
  numero                 String               @db.VarChar(50)
  proveedorId            String?              @db.UniqueIdentifier
  proveedor              String               @db.VarChar(255)
  nit                    String               @db.VarChar(50)
  /// Servicio/suscripción al que pertenece esta factura (p. ej. "Internet
  /// Corporativo"). Opcional: no todas las facturas corresponden a un
  /// servicio recurrente.
  servicioId             String?              @db.UniqueIdentifier
  /// Solicitud de compra que dio origen a esta factura (la solicitud queda en
  /// "Comprado" y esta es la factura final que se paga). Opcional: no toda
  /// factura viene de una solicitud interna.
  solicitudCompraId      String?              @db.UniqueIdentifier
  centroCostos           String?              @db.VarChar(100)
  area                   String               @db.VarChar(100)
  responsableId          String?              @db.UniqueIdentifier
  responsable            String               @db.VarChar(255)
  fecha                  DateTime             @default(now())
  vence                  DateTime
  /// Snapshot de Proveedor.condicionesPago al momento de recibir la
  /// factura (o editado a mano después) — se muestra al usuario en el paso
  /// de "recepción de factura" antes de consolidar el pago.
  condicionesPago        String?              @db.VarChar(500)
  /// Snapshot de Proveedor.datosPago al momento de recibir la factura (o
  /// editado a mano después).
  datosPago              String?              @db.Text
  subtotal               Decimal              @db.Decimal(18, 2)
  iva                    Decimal              @db.Decimal(18, 2)
  total                  Decimal              @db.Decimal(18, 2)
  moneda                 String               @default("COP") @db.VarChar(3)
  estado                 String               @default("Pendiente") @db.VarChar(20)
  prioridad              String               @default("Media") @db.VarChar(20)
  origen                 String               @default("Carga manual") @db.VarChar(20)
  archivoNombre          String?              @db.VarChar(255)
  archivoRuta            String?              @db.VarChar(500)
  archivoMime            String?              @db.VarChar(100)
  archivoTamano          Int?
  archivoSubidoPorNombre String?              @db.VarChar(255)
  archivoSubidoEn        DateTime?
  eliminado              Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id])
  proveedorRel           Proveedor?           @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsableUsuario     User?                @relation("FacturaResponsable", fields: [responsableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicioRel            ServicioSuscripcion? @relation(fields: [servicioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitudCompraRel     SolicitudCompra?     @relation(fields: [solicitudCompraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historial              FacturaHistorial[]
  pagos                  Pago[]

  // Antes era @@unique([tenantId, empresaId, numero]), pero una restricción a
  // nivel de BD no distingue eliminado=true de eliminado=false: una factura
  // borrada (soft-delete) seguía bloqueando para siempre reusar su número.
  // La unicidad real (solo entre facturas activas) se valida en
  // crearFactura(); aquí queda como índice normal para la búsqueda.
  @@index([tenantId, empresaId, numero])
  @@index([tenantId])
  @@index([tenantId, servicioId])
  @@index([tenantId, estado])
  @@index([tenantId, eliminado, estado])
}

model FacturaHistorial {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  facturaId String   @db.UniqueIdentifier
  actor     String   @db.VarChar(255)
  accion    String   @db.VarChar(255)
  detalle   String?  @db.Text
  createdAt DateTime @default(now())
  factura   Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@index([facturaId])
}

/// Pago real aplicado a una factura (fecha, monto, método, comprobante). Una
/// factura puede tener varios pagos (pagos parciales); el saldo pendiente se
/// calcula como total de la factura menos la suma de sus pagos "Confirmado".
/// No se borra un pago erróneo: se anula (estado="Anulado") para conservar
/// la trazabilidad contable, igual que el resto del sistema usa soft-delete.
model Pago {
  id                  String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String   @db.UniqueIdentifier
  facturaId           String   @db.UniqueIdentifier
  fecha               DateTime @default(now())
  valor               Decimal  @db.Decimal(18, 2)
  metodoPago          String   @db.VarChar(50)
  referencia          String?  @db.VarChar(255)
  comprobanteNombre   String?  @db.VarChar(255)
  comprobanteRuta     String?  @db.VarChar(500)
  comprobanteMime     String?  @db.VarChar(100)
  comprobanteTamano   Int?
  /// Nullable a propósito: si el usuario que registró el pago se borra (ver
  /// eliminarUsuario con forzado), el pago se conserva íntegro — el nombre ya
  /// queda guardado en registradoPorNombre, solo se desvincula la FK.
  registradoPorId     String?  @db.UniqueIdentifier
  registradoPorNombre String   @db.VarChar(255)
  observaciones       String?  @db.Text
  estado              String   @default("Confirmado") @db.VarChar(20)
  createdAt           DateTime @default(now())
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  factura             Factura  @relation(fields: [facturaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registradoPor       User?    @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([facturaId])
}

model SolicitudCompra {
  id                           String                @id @default(uuid()) @db.UniqueIdentifier
  tenantId                     String                @db.UniqueIdentifier
  empresaId                    String                @db.VarChar(10)
  area                         String                @db.VarChar(100)
  solicitanteId                String?               @db.UniqueIdentifier
  solicitante                  String                @db.VarChar(255)
  proveedorId                  String?               @db.UniqueIdentifier
  proveedor                    String?               @db.VarChar(255)
  item                         String                @db.VarChar(255)
  descripcion                  String?               @db.Text
  cantidad                     Int
  valorEstimado                Decimal               @db.Decimal(18, 2)
  prioridad                    String                @default("Media") @db.VarChar(20)
  estado                       String                @default("Pendiente") @db.VarChar(20)
  fechaSolicitud               DateTime              @default(now())
  fechaResolucion              DateTime?
  resueltoPorId                String?               @db.UniqueIdentifier
  resueltoPorNombre            String?               @db.VarChar(255)
  comentarioResolucion         String?               @db.Text
  cotizacionNombre             String?               @db.VarChar(255)
  cotizacionRuta               String?               @db.VarChar(500)
  cotizacionMime               String?               @db.VarChar(100)
  cotizacionTamano             Int?
  cotizacionSubidoPorNombre    String?               @db.VarChar(255)
  cotizacionSubidoEn           DateTime?
  /// Confirmación del solicitante original de que recibió físicamente el
  /// producto/servicio. Cierra el ciclo Solicitud->Cotización->Aprobación->
  /// Factura->Pago->Recepción. Solo el propio solicitante puede establecer
  /// estos campos (ver confirmarRecepcionSolicitud), y solo cuando la
  /// factura vinculada ya está "Pagada".
  recepcionConfirmadaPorId     String?               @db.UniqueIdentifier
  recepcionConfirmadaPorNombre String?               @db.VarChar(255)
  recepcionConfirmadaEn        DateTime?
  recepcionComentario          String?               @db.Text
  eliminado                    Boolean               @default(false)
  tenant                       Tenant                @relation(fields: [tenantId], references: [id])
  solicitanteUsuario           User?                 @relation("SolicitudSolicitante", fields: [solicitanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resueltoPor                  User?                 @relation("SolicitudResueltaPor", fields: [resueltoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recepcionConfirmadaPor       User?                 @relation("SolicitudRecepcionConfirmadaPor", fields: [recepcionConfirmadaPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proveedorRel                 Proveedor?            @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facturas                     Factura[]
  cotizacionesProveedor        CotizacionProveedor[]

  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, eliminado, estado])
}

/// Una de las (exactamente 3) cotizaciones de proveedor recogidas para una
/// SolicitudCompra antes de poder aprobarla. Gerencia compara las 3 en el
/// cuadro comparativo y marca una como ganadora (esGanadora); esa selección
/// es la que desbloquea el paso a "Aprobada" (ver cambiarEstadoSolicitud).
model CotizacionProveedor {
  id                String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId          String          @db.UniqueIdentifier
  solicitudCompraId String          @db.UniqueIdentifier
  /// Proveedor del catálogo, cuando la cotización se registra eligiendo uno
  /// ya creado en Configuración > Proveedores (preferido: nombre y NIT se
  /// toman de ahí, nunca del texto que mande el cliente). Null si se cargó
  /// manualmente (proveedor todavía no catalogado) — mismo patrón que
  /// Factura.proveedorId / SolicitudCompra.proveedorId.
  proveedorId       String?         @db.UniqueIdentifier
  proveedorNombre   String          @db.VarChar(255)
  proveedorNit      String          @db.VarChar(50)
  valorTotalCOP     Decimal         @db.Decimal(18, 2)
  tiempoEntregaDias Int
  esGanadora        Boolean         @default(false)
  archivoNombre     String          @db.VarChar(255)
  archivoRuta       String          @db.VarChar(500)
  archivoMime       String          @db.VarChar(100)
  archivoTamano     Int
  /// Nullable a propósito: si el usuario que subió la cotización se borra
  /// (ver eliminarUsuario con forzado), la cotización se conserva íntegra —
  /// el nombre ya queda guardado en subidoPorNombre, solo se desvincula la FK.
  subidoPorId       String?         @db.UniqueIdentifier
  subidoPorNombre   String          @db.VarChar(255)
  createdAt         DateTime        @default(now())
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitudCompra   SolicitudCompra @relation(fields: [solicitudCompraId], references: [id], onDelete: Cascade)
  proveedorRel      Proveedor?      @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subidoPor         User?           @relation("CotizacionProveedorSubidaPor", fields: [subidoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([solicitudCompraId])
  @@index([proveedorId])
}

model ServicioSuscripcion {
  id                 String     @id @default(uuid()) @db.UniqueIdentifier
  tenantId           String     @db.UniqueIdentifier
  empresaId          String     @db.VarChar(10)
  area               String     @db.VarChar(100)
  nombreServicio     String     @db.VarChar(255)
  descripcion        String?    @db.Text
  proveedorId        String?    @db.UniqueIdentifier
  proveedor          String     @db.VarChar(255)
  periodicidad       String     @db.VarChar(20)
  costo              Decimal    @db.Decimal(18, 2)
  moneda             String     @default("COP") @db.VarChar(3)
  fechaInicio        DateTime?
  fechaFin           DateTime?
  /// Día del mes en que recurre el cobro (1-31), independiente de
  /// fechaRenovacion (la próxima fecha concreta de pago).
  diaVencimiento     Int?
  fechaRenovacion    DateTime
  estado             String     @default("Activo") @db.VarChar(30)
  responsableId      String?    @db.UniqueIdentifier
  responsableArea    String     @db.VarChar(255)
  observaciones      String?    @db.Text
  eliminado          Boolean    @default(false)
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  proveedorRel       Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsableUsuario User?      @relation("ServicioResponsable", fields: [responsableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facturas           Factura[]

  @@index([tenantId])
  @@index([tenantId, eliminado, estado])
}

model ReglaEnrutamiento {
  id          String  @id @default(uuid()) @db.UniqueIdentifier
  tenantId    String  @db.UniqueIdentifier
  nombre      String  @db.VarChar(255)
  prioridad   Int     @default(1)
  activa      Boolean @default(true)
  condiciones String  @db.Text
  acciones    String  @db.Text
  ejecuciones Int     @default(0)
  tenant      Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Motor genérico de destinatarios (Fase 5.3) — deliberadamente SEPARADO de
/// ReglaEnrutamiento: ese modelo representa "enrutar una factura" (nunca tuvo
/// intérprete funcional, condiciones/acciones son texto libre sin validar) y
/// este representa "quién debe enterarse de un EVENTO" (SERVICIO_RENOVACION_
/// PROXIMA, OBJETIVO_EN_RIESGO, ...), consumido por notificaciones.ts/
/// inbox.ts existentes — no se mezclan ni se reutiliza uno para el otro.
/// Puede haber más de una ReglaDestinatarios activa para el mismo `evento`;
/// resolverDestinatarios() une los destinatarios de todas.
model ReglaDestinatarios {
  id            String              @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String              @db.UniqueIdentifier
  /// Identificador estable del evento (ej. "SERVICIO_RENOVACION_PROXIMA") —
  /// sin catálogo formal todavía (ver TIPOS_DESTINATARIO_VALIDOS en
  /// resolver-destinatarios.ts para la lista SÍ cerrada de tipos).
  evento        String              @db.VarChar(100)
  activa        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  destinatarios ReglaDestinatario[]

  @@index([tenantId])
  @@index([tenantId, evento])
}

/// Un destinatario lógico dentro de una ReglaDestinatarios. Exactamente uno
/// de usuarioId/perfilId/departamentoId/permisoClave debe estar lleno según
/// `tipo` (RESPONSABLE_REGISTRO no usa ninguno) — validado en el controller,
/// no aquí (Prisma no expresa "exactamente uno de N columnas"). Sin tenantId
/// propio a propósito: su aislamiento es transitivo vía reglaId -> tenantId,
/// nunca se consulta sin pasar primero por una ReglaDestinatarios ya
/// validada contra el tenant activo.
model ReglaDestinatario {
  id             String             @id @default(uuid()) @db.UniqueIdentifier
  reglaId        String             @db.UniqueIdentifier
  /// USUARIO | PERFIL | AREA | RESPONSABLE_REGISTRO | JEFE_AREA | PERMISO
  tipo           String             @db.VarChar(30)
  usuarioId      String?            @db.UniqueIdentifier
  perfilId       String?            @db.UniqueIdentifier
  /// Para tipo=AREA es obligatorio (el área objetivo). Para tipo=JEFE_AREA es
  /// OPCIONAL: si se deja null, resolverDestinatarios() usa
  /// contexto.departamentoId — así una misma regla "avisar al jefe de área"
  /// sirve para cualquier entidad sin fijar de antemano cuál departamento.
  departamentoId String?            @db.UniqueIdentifier
  permisoClave   String?            @db.VarChar(150)
  regla          ReglaDestinatarios @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  @@index([reglaId])
}

model CreditoCliente {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  cliente   String   @db.VarChar(255)
  cupo      Decimal  @db.Decimal(18, 2)
  saldo     Decimal  @db.Decimal(18, 2)
  vence     DateTime
  estado    String   @default("Al día") @db.VarChar(20)
  eliminado Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, eliminado, estado])
}

/// Snapshot cacheado de t9896_pdv_clientes_analisis (Siesa) para UN cliente
/// (tenantId + clienteRowId, mismo patrón que OportunidadSeguimiento — Siesa
/// puro, sin FK). NO reemplaza la cartera real (t353_co_saldo_abierto, ver
/// GET /creditos/cartera-siesa, que sigue siendo la fuente viva): t9896 es un
/// snapshot de análisis crediticio cuya frecuencia real de refresco en Siesa
/// no está confirmada, así que `actualizadoEn` (cuándo RicoSoft lo leyó por
/// última vez) debe mostrarse siempre junto al dato en la UI.
model IndicadorCreditoCliente {
  id                  String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String   @db.UniqueIdentifier
  clienteRowId        Int
  cupoCredito         Decimal  @db.Decimal(18, 2)
  disponible          Decimal  @db.Decimal(18, 2)
  carteraCorriente    Decimal  @db.Decimal(18, 2)
  carteraVencida      Decimal  @db.Decimal(18, 2)
  diasPromedioVencido Int?
  diasPromedioPago    Int?
  bloquearCupo        Boolean  @default(false)
  bloquearMora        Boolean  @default(false)
  bloquear            Boolean  @default(false)
  /// Siempre "T9896_SNAPSHOT" hoy — campo previsto para si en el futuro se
  /// agrega otro origen (p. ej. un cálculo propio de RicoSoft).
  origenDato          String   @default("T9896_SNAPSHOT") @db.VarChar(30)
  actualizadoEn       DateTime @default(now())
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clienteRowId])
  @@index([tenantId])
}

/// Toma física mensual — Etapa I del módulo Producción & Planeación.
/// Modelo NATIVO de RicoSoft (no existe en Siesa: se buscaron tablas de
/// conteo físico/ajuste de inventario y no se encontró ninguna). La bodega
/// (bodegaRowId) SÍ es real: referencia t150_mc_bodegas de Siesa,
/// verificado en vivo contra t400_cm_existencia. RicoSoft nunca escribe en
/// Siesa (integración de solo lectura) — "cerrar" una toma física es un
/// registro interno de RicoSoft, no un ajuste real en el sistema contable;
/// el ajuste en Siesa lo hace un usuario manualmente allá, si corresponde.
model TomaFisica {
  id            String            @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String            @db.UniqueIdentifier
  bodegaRowId   Int
  bodegaNombre  String            @db.VarChar(255)
  fecha         DateTime
  estado        String            @default("Abierta") @db.VarChar(20)
  responsableId String            @db.UniqueIdentifier
  responsable   String            @db.VarChar(255)
  createdAt     DateTime          @default(now())
  cerradaEn     DateTime?
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  lineas        TomaFisicaLinea[]

  @@index([tenantId])
}

/// Una línea por ítem de la bodega, con el stock del sistema (snapshot de
/// Siesa al momento de crear la toma) y el conteo físico (null hasta que
/// alguien lo registre). Diferencia/diferenciaPct/valorDiferencia se
/// calculan siempre al leer (lib/toma-fisica.ts), nunca se guardan — evita
/// que queden desactualizados si se corrige un conteo.
model TomaFisicaLinea {
  id            String     @id @default(uuid()) @db.UniqueIdentifier
  tomaFisicaId  String     @db.UniqueIdentifier
  itemRowId     Int
  descripcion   String?    @db.VarChar(255)
  referencia    String?    @db.VarChar(255)
  stockSistema  Decimal    @db.Decimal(18, 4)
  conteoFisico  Decimal?   @db.Decimal(18, 4)
  valorUnitario Decimal    @db.Decimal(18, 2)
  tomaFisica    TomaFisica @relation(fields: [tomaFisicaId], references: [id], onDelete: Cascade)

  @@index([tomaFisicaId])
}

/// Umbrales del módulo Producción & Planeación, configurables por tenant en
/// vez de constantes fijas en el código (Parte 16 del plan de
/// implementación). Una fila por tenant como máximo — si no existe, el
/// backend usa los valores por defecto documentados en
/// lib/inventario-siesa.ts, lib/cobertura-siesa.ts, etc.
model ConfiguracionInventario {
  id                              String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId                        String   @unique @db.UniqueIdentifier
  /// Días sin venta o menos: "vendible".
  diasVendible                    Int      @default(60)
  /// Días sin venta o menos (y > diasVendible): "exceso"; más: "obsolescencia".
  diasExceso                      Int      @default(180)
  /// Días de cobertura o menos: riesgo de ruptura de stock.
  diasRupturaCobertura            Int      @default(15)
  /// Días de cobertura o más: sobre-cobertura (exceso de inventario frente a la venta).
  diasSobreCobertura              Int      @default(180)
  /// Inventario objetivo (Fase 6): días de cobertura que el negocio quiere mantener en stock — usado por domain/planeacion/inventario-objetivo.ts.
  coberturaObjetivoDias           Int      @default(45)
  /// Multiplicador de seguridad sobre el inventario objetivo (1.0 = sin margen extra; 1.2 = 20% adicional de colchón).
  factorSeguridad                 Float    @default(1.0)
  /// Variabilidad de demanda (coeficiente de variación) a partir de la cual se considera "alta" — lib/demanda-siesa.ts.
  umbralVariabilidadAltaDemanda   Float    @default(0.75)
  /// Fracción de pérdida de rotación a partir de la cual se marca como relevante — lib/demanda-siesa.ts.
  umbralPerdidaRotacionDemanda    Float    @default(0.5)
  /// Porcentaje de tendencia (creciente/decreciente) a partir del cual se considera "fuerte" — lib/demanda-siesa.ts.
  umbralTendenciaFuertePctDemanda Float    @default(20)
  /// Porcentaje de diferencia entre TRM oficial y TRM de la orden a partir del cual se alerta al usuario.
  umbralAlertaTrmPct              Float    @default(2)
  /// Plazo de crédito/renovación por defecto (días) cuando no se especifica uno propio.
  plazoCreditoDiasDefecto         Int      @default(30)
  /// Mínimo de cotizaciones de proveedor requeridas para poder aprobar una SolicitudCompra.
  minimoCotizacionesSolicitud     Int      @default(3)
  /// --- Parámetros de negocio (fuente central) ---------------------------
  /// Solo se ALMACENAN aquí: ninguna regla de Ventas/Crédito/Compras/Logística
  /// los consume todavía (ver lib/parametros-negocio.ts). Decimal, no Float,
  /// porque son porcentajes/montos financieros.
  /// Margen mínimo de venta (%) — Ventas.
  margenMinimoVentaPct            Decimal  @default(0) @db.Decimal(5, 2)
  /// Días máximos de mora tolerados a un cliente — Crédito.
  diasMaximosMora                 Int      @default(30)
  /// % máximo del cupo de crédito que se puede usar — Crédito.
  porcentajeMaximoUsoCupo         Decimal  @default(100) @db.Decimal(5, 2)
  /// Tolerancia de merma de pesaje (%) — Inventario / Logística.
  toleranciaMermaPesajePct        Decimal  @default(0.5) @db.Decimal(5, 2)
  /// Días de validez estándar de una oferta/cotización — Ventas.
  diasValidezOferta               Int      @default(15)
  /// Monto (moneda local) desde el cual se exigen cotizaciones — Compras.
  /// 0 = sin monto mínimo definido.
  montoMinimoCotizaciones         Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt                       DateTime @updatedAt
  tenant                          Tenant   @relation(fields: [tenantId], references: [id])
}

/// Tasas de retención comercial por tenant (módulo Ventas/Proformas) — a
/// propósito NO se mezcla con ConfiguracionInventario (dominio distinto,
/// misma forma: una fila por tenant, campos tipados con default). Una
/// Proforma copia estos porcentajes al crearse (snapshot en
/// Proforma.retencionPct/retencionIvaPct/icaPct) y nunca vuelve a leerlos —
/// cambiar esta configuración solo afecta proformas nuevas.
model ConfiguracionComercial {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId           String   @unique @db.UniqueIdentifier
  /// Retención en la fuente = Total bruto × este %.
  retencionFuentePct Decimal  @default(2.5) @db.Decimal(5, 2)
  /// Retención de IVA = Valor IVA × este % (sobre el impuesto, no sobre el bruto).
  retencionIvaPct    Decimal  @default(15) @db.Decimal(5, 2)
  /// Retención ICA = Total bruto × este %.
  retencionIcaPct    Decimal  @default(0.7) @db.Decimal(5, 2)
  /// Contador MONOTÓNICO del consecutivo de Proforma del tenant (piso
  /// histórico 3890: la última proforma en Excel fue la 3889). Nunca
  /// retrocede: el siguiente número efectivo es
  /// max(este valor, MAX(Proforma.numero) + 1) — ver
  /// modules/proformas/proformas-consecutivo.ts. Se sube al crear una
  /// proforma (auto o manual mayor) y por PUT solo hacia arriba.
  siguienteConsecutivoProforma Int @default(3890)
  /// Contador MONOTÓNICO del consecutivo de PedidoComercial del tenant (primer
  /// pedido = 1). Siguiente efectivo = max(este valor, MAX(PedidoComercial.numero)+1);
  /// se avanza dentro de la transacción que crea el pedido. Ver
  /// modules/comercial/pedidos-consecutivo.ts.
  siguienteConsecutivoPedidoComercial Int @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
}

/// Catálogo genérico de valores de referencia (comercio internacional, CRM,
/// notificaciones, etc.) — reemplaza arrays hardcodeados duplicados entre
/// backend y frontend. tenantId = NULL significa alcance GENERAL (visible
/// para todos los tenants); con valor = exclusivo de esa empresa. Mismo
/// patrón que Departamento/Rol/Modulo (ver lib/alcance.ts, whereAlcance).
model CatalogoValor {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  /// Discriminador. Lista vigente en TIPOS_CATALOGO_VALIDOS
  /// (modules/catalogos/catalogos.controller.ts): INCOTERM, MONEDA, PAIS,
  /// CONDICION_PAGO, METODO_PAGO, UNIDAD_MEDIDA, MOTIVO_NOVEDAD_DESPACHO,
  /// ESTADO_COMERCIAL, TIPO_OPORTUNIDAD y los tipos heredados (PAIS_ORIGEN,
  /// FORMA_PAGO, FORMA_PAGO_VENTAS, MOTIVO_NOVEDAD_IMPORTACION,
  /// ACCION_CONTACTO_OPORTUNIDAD, RESULTADO_CONTACTO_OPORTUNIDAD).
  tipo        String   @db.VarChar(60)
  /// Valor estable usado por el código/datos ya guardados (ej. "FOB") — nunca
  /// se debe cambiar una clave existente sin migrar los datos que la usan.
  clave       String   @db.VarChar(100)
  etiqueta    String   @db.VarChar(255)
  /// Texto explicativo opcional (p. ej. qué significa un Incoterm).
  descripcion String?  @db.NVarChar(500)
  /// JSON validado en el backend (ver lib/catalogos.ts, esquemaMetadata):
  /// { simbolo?, responsabilidad?, documento?, aliases?: string[] }.
  /// `aliases` son claves heredadas que ya viven en datos históricos (p. ej.
  /// "TON" para la clave "TN"): los validadores aceptan clave o alias, y así
  /// se puede normalizar el catálogo sin romper filas antiguas.
  metadata    String?  @db.NVarChar(Max)
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  tenantId    String?  @db.UniqueIdentifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([tipo, clave, tenantId])
  @@index([tipo, tenantId, activo])
}

/// Plantilla de texto para notificaciones in-app, reemplazando template
/// literals embebidos en controllers. tenantId = NULL significa alcance
/// GENERAL (compartida por todos los tenants). El texto soporta placeholders
/// "{{nombrePlaceholder}}" que cada emisor reemplaza según su evento —
/// documentar los placeholders soportados de cada tipoEvento en el emisor.
model PlantillaNotificacion {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String?  @db.UniqueIdentifier
  /// Clave estable del evento que dispara la notificación, ej.
  /// "SOLICITUD_PENDIENTE_APROBACION", "SOLICITUD_RESUELTA", "FACTURA_VENCE_PRONTO".
  tipoEvento String   @db.VarChar(100)
  titulo     String   @db.VarChar(255)
  mensaje    String   @db.NVarChar(Max)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([tipoEvento, tenantId])
}

/// Contenido corporativo mostrado en el Home ("Inicio"): novedades, avisos y
/// próximos eventos. Mismo patrón de alcance GENERAL/TENANT que
/// PlantillaNotificacion/Departamento/Rol — nunca se filtra en el frontend,
/// el backend solo devuelve lo que corresponde al tenant de la sesión (más lo
/// GENERAL, visible en todas las empresas del grupo).
model Publicacion {
  id       String  @id @default(uuid()) @db.UniqueIdentifier
  tenantId String? @db.UniqueIdentifier

  /// NOVEDAD (sección "Novedades de la organización") | AVISO (sección
  /// "Información importante") | EVENTO (sección "Próximos eventos").
  categoria String @db.VarChar(20)
  /// Etiqueta libre dentro de la categoría para diferenciar visualmente sin
  /// necesitar un enum cerrado (ej. "Comunicado", "Seguridad", "Gestión
  /// Humana", "Sistemas").
  tipo      String @db.VarChar(50)
  titulo    String @db.VarChar(255)
  contenido String @db.NVarChar(Max)

  fechaPublicacion DateTime  @default(now())
  /// Si se cumple, la publicación deja de listarse aunque siga activa=true
  /// (evita tener que recordar desactivarla a mano).
  fechaVencimiento DateTime?
  /// Solo aplica a categoria=EVENTO: cuándo ocurre el evento (distinto de
  /// fechaPublicacion, que es cuándo se publicó el aviso del evento).
  fechaEvento      DateTime?

  activo    Boolean  @default(true)
  autorId   String   @db.UniqueIdentifier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  autor  User    @relation("PublicacionAutor", fields: [autorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  archivos PublicacionArchivo[]

  @@index([tenantId, categoria, activo])
}

/// Archivo adjunto de una Publicacion (foto, video o documento). No lleva
/// tenantId propio: el alcance (GENERAL / tenant) lo define la publicación
/// padre, y todo acceso al archivo pasa primero por whereAlcance() sobre ella.
model PublicacionArchivo {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  publicacionId  String   @db.UniqueIdentifier
  /// IMAGEN | VIDEO | DOCUMENTO — derivado del mime real al subir.
  tipo           String   @db.VarChar(20)
  nombreOriginal String   @db.VarChar(255)
  mime           String   @db.VarChar(100)
  tamano         Int
  /// Ruta relativa dentro de uploads/publicaciones/, nunca una URL pública.
  ruta           String   @db.VarChar(500)
  createdAt      DateTime @default(now())

  publicacion Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([publicacionId])
}

/// Plan de producción con estados — Etapa J del módulo Producción &
/// Planeación. Modelo nativo de RicoSoft: Siesa no trackea WIP en tiempo
/// real (t851_mf_op_docto_item confirmado en vivo con 0 líneas abiertas) ni
/// tiene un MRP usable (t834_mf_ordenes_planeadas abandonado). Se puede
/// crear a mano o a partir de una recomendación de producción (Bloque 4,
/// lib/produccion-siesa.ts) — RicoSoft nunca escribe de vuelta a Siesa: este
/// plan es solo seguimiento interno del avance, no crea una orden real allá.
model PlanProduccion {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId         String   @db.UniqueIdentifier
  itemRowId        Int
  descripcion      String?  @db.VarChar(255)
  referencia       String?  @db.VarChar(255)
  unidadMedida     String?  @db.VarChar(50)
  cantidadPlaneada Decimal  @db.Decimal(18, 4)
  /// Planificada -> Aprobada -> En producción -> Parcial | Terminada; Cancelada desde cualquier estado no terminal.
  estado           String   @default("Planificada") @db.VarChar(20)
  fechaPlaneada    DateTime
  responsableId    String   @db.UniqueIdentifier
  responsable      String   @db.VarChar(255)
  notas            String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Gestión de liquidación — Fase G (acción "Liquidar" del Centro de
/// Decisiones). RicoSoft NUNCA modifica las existencias reales en Siesa
/// (Siesa es de solo lectura para este sistema): este modelo registra la
/// DECISIÓN empresarial y su seguimiento, no un ajuste de inventario real.
/// "EJECUTADA" significa que la empresa realizó la acción comercial/
/// operativa fuera de esta integración (o que en el futuro exista una
/// integración explícita que la ejecute) — nunca un escritura automática
/// a Siesa. Snapshot de score/categoría/valor al momento de crear el
/// registro (viene directo de domain/planeacion/liquidacion.ts, nunca
/// recalculado en el frontend) — si luego cambia en Siesa, esta gestión
/// sigue reflejando el contexto real que motivó la decisión.
model GestionLiquidacion {
  id                String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId          String   @db.UniqueIdentifier
  itemRowId         Int
  descripcion       String?  @db.VarChar(255)
  referencia        String?  @db.VarChar(255)
  cantidadExistente Decimal  @db.Decimal(18, 4)
  valorTotal        Decimal  @db.Decimal(18, 2)
  score             Int
  /// CRITICA | ALTA | MEDIA | BAJA
  categoria         String   @db.VarChar(10)
  motivo            String   @db.VarChar(500)
  /// PENDIENTE -> EN_REVISION -> APROBADA | RECHAZADA -> EJECUTADA
  estado            String   @default("PENDIENTE") @db.VarChar(20)
  responsableId     String   @db.UniqueIdentifier
  responsable       String   @db.VarChar(255)
  createdAt         DateTime @default(now())
  actualizadoEn     DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Control de Despachos — torre de control operativa del ciclo
/// recibido→preparado→cargado→despachado→en tránsito→entregado.
///
/// DECISIÓN ARQUITECTÓNICA: RicoSoft no tiene un modelo "Pedido" ni
/// "Cliente" nativo — todo lo comercial (ventas, cliente, productos,
/// cantidades) vive en vivo en Siesa (v470_ventas + t461_cm_docto_factura_
/// venta), ya facturado. Un Despacho SIEMPRE se origina desde un documento
/// de venta REAL de Siesa (siesaDocRowId = f461_rowid_docto) — nunca se
/// inventa un pedido paralelo. Cliente/producto/cantidades se congelan al
/// crear (mismo patrón que TomaFisica con la existencia de Siesa): un
/// snapshot, no una relación viva. RicoSoft nunca escribe de vuelta a
/// Siesa — "preparado"/"cargado"/etc. es seguimiento logístico 100% nativo
/// de RicoSoft, no un ajuste de inventario ni un estado de Siesa.
///
/// Bodega/vehículo/conductor son texto libre (no relaciones): no existe
/// maestro de bodegas propio (Toma Física ya usa bodegas de Siesa
/// solo-lectura) ni de vehículos/conductores — crear esas tablas ahora
/// sería sobre-ingeniería sin flota que gestionar todavía.
///
/// El historial de eventos reutiliza el modelo Auditoria existente
/// (entidadTipo="Despacho", entidadId=Despacho.id) en vez de crear una
/// tabla de eventos paralela — mismo mecanismo que ya usa el resto del
/// sistema para trazabilidad.
model Despacho {
  id                   String            @id @default(uuid()) @db.UniqueIdentifier
  tenantId             String            @db.UniqueIdentifier
  /// t461_cm_docto_factura_venta.f461_rowid_docto — documento de venta real de origen.
  siesaDocRowId        Int
  siesaDocReferencia   String?           @db.VarChar(100)
  clienteNombre        String            @db.VarChar(255)
  clienteNit           String?           @db.VarChar(50)
  direccionEntrega     String?           @db.VarChar(500)
  contactoEntrega      String?           @db.VarChar(255)
  telefonoContacto     String?           @db.VarChar(50)
  bodegaRowId          Int?
  bodegaNombre         String?           @db.VarChar(255)
  valorPedido          Decimal           @db.Decimal(18, 2)
  /// RECIBIDO -> PREPARANDO -> PREPARADO -> PENDIENTE_CARGUE -> CARGANDO ->
  /// CARGADO -> DESPACHADO -> EN_TRANSITO -> ENTREGADO | ENTREGA_PARCIAL;
  /// CANCELADO desde cualquier estado antes de CARGADO; DEVUELTO desde
  /// EN_TRANSITO/ENTREGA_PARCIAL. Ver lib/despachos.ts para la máquina completa.
  estado               String            @default("RECIBIDO") @db.VarChar(20)
  vehiculoPlaca        String?           @db.VarChar(20)
  vehiculoTipo         String?           @db.VarChar(50)
  conductorNombre      String?           @db.VarChar(255)
  conductorTelefono    String?           @db.VarChar(50)
  fechaCargue          DateTime?
  fechaDespacho        DateTime?
  fechaEntregaEstimada DateTime?
  fechaEntregaReal     DateTime?
  recibidoPor          String?           @db.VarChar(255)
  responsableId        String            @db.UniqueIdentifier
  responsable          String            @db.VarChar(255)
  createdAt            DateTime          @default(now())
  actualizadoEn        DateTime          @updatedAt
  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  lineas               DespachoLinea[]
  novedades            DespachoNovedad[]

  @@unique([tenantId, siesaDocRowId])
  @@index([tenantId, estado])
}

/// Línea de producto del despacho — snapshot congelado de la línea de venta
/// real en Siesa (v470_ventas) al momento de crear el despacho. Permite
/// registrar avance de preparación/despacho/entrega SIN tocar existencias
/// de Siesa: es seguimiento, no un movimiento de inventario real.
model DespachoLinea {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier
  despachoId         String   @db.UniqueIdentifier
  itemRowId          Int
  descripcion        String?  @db.VarChar(255)
  referencia         String?  @db.VarChar(255)
  unidadMedida       String?  @db.VarChar(50)
  cantidadSolicitada Decimal  @db.Decimal(18, 4)
  cantidadPreparada  Decimal? @db.Decimal(18, 4)
  cantidadDespachada Decimal? @db.Decimal(18, 4)
  cantidadEntregada  Decimal? @db.Decimal(18, 4)
  observacion        String?  @db.VarChar(500)
  despacho           Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  @@index([despachoId])
}

/// Novedad registrada durante el ciclo del despacho (faltante, dirección
/// incorrecta, cliente ausente, avería, rechazo, devolución, etc.) — no
/// bloquea automáticamente el estado logístico: el responsable decide si
/// amerita mover el Despacho a DEVUELTO/CANCELADO explícitamente.
model DespachoNovedad {
  id                    String    @id @default(uuid()) @db.UniqueIdentifier
  despachoId            String    @db.UniqueIdentifier
  /// PRODUCTO_FALTANTE | DIRECCION_INCORRECTA | CLIENTE_AUSENTE |
  /// VEHICULO_NO_DISPONIBLE | MERCANCIA_AVERIADA | ENTREGA_PARCIAL |
  /// RECHAZO_CLIENTE | DEVOLUCION | OTRA
  tipo                  String    @db.VarChar(30)
  descripcion           String    @db.VarChar(500)
  /// ABIERTA -> RESUELTA
  estado                String    @default("ABIERTA") @db.VarChar(10)
  usuarioId             String    @db.UniqueIdentifier
  usuario               String    @db.VarChar(255)
  createdAt             DateTime  @default(now())
  resueltaPorId         String?   @db.UniqueIdentifier
  resueltaPor           String?   @db.VarChar(255)
  fechaResolucion       DateTime?
  observacionResolucion String?   @db.VarChar(500)
  despacho              Despacho  @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  @@index([despachoId])
}

model ProyeccionMensual {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  mes        String   @db.VarChar(20)
  anio       Int
  proyectado Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, mes, anio])
  @@index([tenantId])
}

/// Analítica > Constructor de análisis: una configuración de análisis
/// guardada por un usuario (métrica + dimensión + período + filtros + orden
/// + límite + visualización elegidos del catálogo cerrado de
/// analitica-catalogo.ts — nunca SQL ni una métrica libre). Privado por
/// usuario dentro del tenant: no existe hoy un concepto de "análisis
/// compartido" en el negocio, así que un usuario nunca ve los análisis
/// guardados de otro usuario del mismo tenant (ver aislamiento en
/// analitica.controller.ts: toda operación filtra por tenantId Y usuarioId).
model AnalisisGuardado {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String   @db.UniqueIdentifier
  usuarioId     String   @db.UniqueIdentifier
  nombre        String   @db.VarChar(150)
  /// JSON con { metrica, dimensionPrincipal, dimensionSecundaria?,
  /// fechaInicio, fechaFin, filtros, orden, limite, visualizacion } — la
  /// misma forma que valida analitica-catalogo.ts al ejecutar. Se
  /// revalida contra el catálogo cada vez que se ejecuta (nunca se
  /// confía en una configuración guardada como si ya estuviera validada).
  configuracion String   @db.NVarChar(4000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  usuario       User     @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, usuarioId])
}

/// Meta comercial (Comercial → Objetivos). Fuente de la venta real SIEMPRE
/// es Siesa (t461_cm_docto_factura_venta / v470_ventas) — este modelo solo
/// guarda la META y su metadata, nunca cifras de venta calculadas (esas se
/// leen en vivo en cada consulta, ver server/src/lib/objetivos-calculo.ts).
model Objetivo {
  id       String @id @default(uuid()) @db.UniqueIdentifier
  tenantId String @db.UniqueIdentifier

  /// "EMPRESA" = meta comercial global del tenant. "VENDEDOR" = meta
  /// individual. La suma de objetivos VENDEDOR nunca se asume igual al
  /// objetivo EMPRESA del mismo período — son entidades independientes.
  nivel String @db.VarChar(20)

  /// Solo poblado cuando nivel = "VENDEDOR". Referencia LIBRE a
  /// t200_mm_terceros.f200_rowid en Siesa (el vendedor vive en Siesa, no en
  /// RicoSoft) — no es una FK de Prisma. vendedorSiesaNombre es un snapshot
  /// del nombre al momento de crear la meta, igual que Factura.responsable.
  vendedorSiesaRowId  Int?
  vendedorSiesaNombre String? @db.VarChar(255)

  /// "MENSUAL" | "TRIMESTRAL" | "ANUAL" | "PERSONALIZADO" — solo clasifica
  /// para la UI. El cumplimiento SIEMPRE se calcula contra
  /// fechaInicio/fechaFin reales, nunca se re-derivan de tipoPeriodo.
  tipoPeriodo String @db.VarChar(20)

  fechaInicio DateTime @db.Date
  /// Inclusive.
  fechaFin    DateTime @db.Date
  /// Denormalizado de fechaInicio, para filtrar por año fiscal (= año
  /// calendario) sin tener que derivarlo de fechaInicio en cada query.
  anio        Int

  /// Meta en valor (COP), SIN IVA — mismo criterio que
  /// f461_vlr_bruto - f461_vlr_dscto. Nullable: una meta puede ser solo de
  /// volumen.
  metaValor Decimal? @db.Decimal(18, 2)

  /// Meta de volumen, siempre normalizada a KG (1 TON = 1000 KG convertido
  /// antes de guardar). Nullable: una meta puede ser solo de valor.
  metaVolumenKg Decimal? @db.Decimal(18, 3)

  /// Campo preparado, SIN query ni UI activa hasta validar la fuente exacta
  /// de inventario en Siesa (RicoSoft no es el sistema de inventario).
  metaInventario     Decimal? @db.Decimal(18, 3)
  /// "MINIMO" | "OBJETIVO" | "MAXIMO" | "A_MANTENER" | "A_VENDER" —
  /// documentativo hasta que metaInventario se active.
  tipoMetaInventario String?  @db.VarChar(20)

  descripcion String? @db.Text

  /// "BORRADOR" | "ACTIVO" | "CANCELADO". "CERRADO" NO se persiste: se
  /// deriva en la capa de lectura cuando fechaFin < hoy, para no requerir
  /// un job/cron que transicione estados.
  estado String @default("ACTIVO") @db.VarChar(20)

  /// Soft delete: el histórico de metas (incluidas las eliminadas) es
  /// insumo para analizar qué decidió Gerencia y qué resultado tuvo.
  eliminado Boolean @default(false)

  creadoPorId       String  @db.UniqueIdentifier
  creadoPorNombre   String  @db.VarChar(255)
  /// Quién asignó la meta, si es distinto de quién la creó (p. ej.
  /// Gerencia General asigna una meta VENDEDOR preparada por un asistente).
  asignadoPorId     String? @db.UniqueIdentifier
  asignadoPorNombre String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@index([tenantId, fechaInicio, fechaFin])
  @@index([tenantId, nivel, vendedorSiesaRowId])
  @@index([tenantId, anio])
}

/// Capa ligera de seguimiento comercial sobre una Oportunidad (Fase de
/// Motor de Decisiones — Comercial). NO es un CRM: es un timeline de
/// interacciones sobre un cliente/producto de Siesa, para que "esta empresa
/// podría comprar X" se convierta en "quién la contacta, cuándo, y qué pasó
/// la última vez". Cada fila es UN evento de seguimiento, nunca se
/// sobreescribe — el estado "actual" de la oportunidad es el resultado del
/// evento más reciente (se calcula en el controller, no se guarda
/// duplicado aquí). clienteRowId/itemRowId son ids de Siesa (mismo patrón
/// que CotizacionProveedor.proveedorId — referencia externa, no FK), nunca
/// se crea un catálogo propio de clientes/productos.
model OportunidadSeguimiento {
  id                        String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId                  String    @db.UniqueIdentifier
  /// t200_mm_terceros.f200_rowid del cliente — igual que en el resto del
  /// sistema (SolicitudCompra.proveedorId, CotizacionProveedor, etc. son
  /// FK propias; esto es Siesa puro, como itemRowId en otros módulos).
  clienteRowId              Int
  clienteNombre             String    @db.VarChar(255)
  /// Producto de la oportunidad concreta, si aplica (una oportunidad puede
  /// ser general del cliente o sobre un producto puntual del cruce de
  /// oportunidad-comercial-siesa.ts).
  itemRowId                 Int?
  itemDescripcion           String?   @db.VarChar(255)
  /// Llamada | WhatsApp | Correo | Reunion | Visita | Cotizacion | Seguimiento | Otro
  accion                    String    @db.VarChar(30)
  /// Contactado | SinRespuesta | Interesado | CotizacionSolicitada |
  /// CotizacionEnviada | EnNegociacion | NoInteresado | VentaRealizada
  resultado                 String    @db.VarChar(30)
  comentario                String?   @db.Text
  /// Obligatorios cuando el resultado no es terminal (NoInteresado /
  /// VentaRealizada) — validado en el controller, no aquí: una oportunidad
  /// activa sin próxima acción es solo un dato analítico, no algo
  /// accionable (ver Motor de Decisiones).
  proximaAccion             String?   @db.VarChar(255)
  proximoSeguimientoFecha   DateTime?
  /// Compromiso = proximaAccion + proximoSeguimientoFecha de ESTE evento.
  /// createdAt es cuándo se REGISTRÓ el evento, nunca cuándo se ejecutó el
  /// compromiso — por eso el cierre necesita su propia fecha (compromisoCompletadoEn),
  /// distinta de createdAt y distinta de proximoSeguimientoFecha (la programada).
  compromisoCompletado      Boolean   @default(false)
  compromisoCompletadoEn    DateTime?
  /// Plano (id + nombre en texto), igual que usuarioId/usuario arriba — sin
  /// FK a User, mismo criterio ya usado en todo este modelo.
  compromisoCompletadoPorId String?   @db.UniqueIdentifier
  compromisoCompletadoPor   String?   @db.VarChar(255)
  usuarioId                 String    @db.UniqueIdentifier
  usuario                   String    @db.VarChar(255)
  createdAt                 DateTime  @default(now())
  tenant                    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clienteRowId])
}

model Empleado {
  id                     String                @id @default(uuid()) @db.UniqueIdentifier
  tenantId               String                @db.UniqueIdentifier
  empresaId              String                @db.VarChar(10)
  documento              String                @db.VarChar(50)
  nombres                String                @db.VarChar(255)
  apellidos              String                @db.VarChar(255)
  /// NULL cuando el cargo asignado no exige correo corporativo
  /// (CargoColaborador.correoCorporativoRequerido = false) y no se diligenció.
  correo                 String?               @db.VarChar(255)
  /// Nombre del cargo como texto (snapshot): se conserva aunque el cargo del
  /// catálogo se desactive o cambie, y es lo que ya leen las vistas actuales.
  cargo                  String                @db.VarChar(255)
  /// Cargo del catálogo por tenant. NULL en colaboradores históricos (anteriores
  /// al catálogo) o registrados sin cargo del catálogo.
  cargoId                String?               @db.UniqueIdentifier
  /// Tipo de contrato (nombre elegido del catálogo CatalogoSeguridadSocial,
  /// tipo TIPO_CONTRATO; snapshot en texto). NULL en colaboradores históricos.
  tipoContrato           String?               @db.VarChar(150)
  area                   String                @db.VarChar(100)
  fechaContratacion      DateTime
  fechaLiquidacion       DateTime?
  salarioActual          Decimal               @db.Decimal(18, 2)
  estado                 String                @default("Activo") @db.VarChar(20)
  eliminado              Boolean               @default(false)
  createdAt              DateTime              @default(now())
  tenant                 Tenant                @relation(fields: [tenantId], references: [id])
  cargoCatalogo          CargoColaborador?     @relation(fields: [cargoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faltas                 FaltaStrike[]
  historicoSalario       HistorialSalario[]
  permisos               PermisoLaboral[]
  vinculosBiometricos    EmpleadoBiometrico[]
  marcacionesBiometricas MarcacionBiometrica[]
  detalle                EmpleadoDetalle?
  familiares             EmpleadoFamiliar[]
  estudios               EmpleadoEstudio[]
  documentos             EmpleadoDocumento[]

  @@index([tenantId])
  @@index([cargoId])
}

/// Catálogo de cargos por tenant (Gestión Humana). tenantId NOT NULL: no hay
/// cargos GENERALES (a diferencia de Departamento). Nunca se elimina
/// físicamente un cargo: se desactiva (activo=false) y los colaboradores ya
/// asignados conservan el vínculo y el nombre.
model CargoColaborador {
  id                         String     @id @default(uuid()) @db.UniqueIdentifier
  tenantId                   String     @db.UniqueIdentifier
  nombre                     String     @db.VarChar(255)
  /// nombre sin tildes, en minúsculas y con espacios colapsados; respalda la
  /// unicidad por tenant (también frente a creaciones concurrentes).
  nombreNormalizado          String     @db.VarChar(255)
  activo                     Boolean    @default(true)
  correoCorporativoRequerido Boolean    @default(true)
  departamentoId             String?    @db.UniqueIdentifier
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  tenant                     Tenant     @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  empleados                  Empleado[]
  departamento               Departamento? @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, nombreNormalizado])
  @@index([tenantId])
  @@index([departamentoId])
}

/// Catálogo por tenant de EPS, ARL y fondos de pensiones (Gestión de
/// información de Gestión Humana). EmpleadoDetalle guarda el NOMBRE elegido
/// como texto (snapshot): desactivar o renombrar una entrada no altera lo ya
/// registrado en los colaboradores.
model CatalogoSeguridadSocial {
  id                String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId          String   @db.UniqueIdentifier
  /// EPS | ARL | FONDO_PENSIONES | TIPO_CONTRATO
  tipo              String   @db.VarChar(20)
  nombre            String   @db.VarChar(150)
  nombreNormalizado String   @db.VarChar(150)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@unique([tenantId, tipo, nombreNormalizado])
  @@index([tenantId, tipo])
}

/// Detalles personales opcionales del colaborador (1:1). Contiene datos
/// sensibles (afiliaciones de salud/riesgos y datos de contacto): solo se
/// exponen con empleados.detalles_ver.
model EmpleadoDetalle {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId           String   @db.UniqueIdentifier
  empleadoId         String   @unique @db.UniqueIdentifier
  eps                String?  @db.VarChar(150)
  arl                String?  @db.VarChar(150)
  fondoPensiones     String?  @db.VarChar(150)
  /// Fechas "solo día" guardadas como medianoche UTC.
  fechaNacimiento    DateTime? @db.Date
  lugarNacimiento    String?  @db.VarChar(150)
  fechaExpedicionDocumento DateTime? @db.Date
  correoPersonal     String?  @db.VarChar(255)
  ciudadResidencia   String?  @db.VarChar(100)
  departamentoResidencia String? @db.VarChar(100)
  direccion          String?  @db.VarChar(255)
  telefonoPrincipal  String?  @db.VarChar(30)
  telefonoSecundario String?  @db.VarChar(30)
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  empleado           Empleado @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
}

/// Núcleo familiar: solo nombre y parentesco (minimización de datos de
/// terceros; cualquier otro atributo requiere aprobación previa).
model EmpleadoFamiliar {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  empleadoId String   @db.UniqueIdentifier
  nombre     String   @db.VarChar(255)
  parentesco String   @db.VarChar(50)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([empleadoId])
}

model EmpleadoEstudio {
  id          String              @id @default(uuid()) @db.UniqueIdentifier
  tenantId    String              @db.UniqueIdentifier
  empleadoId  String              @db.UniqueIdentifier
  titulo      String              @db.VarChar(255)
  institucion String?             @db.VarChar(255)
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  empleado    Empleado            @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentos  EmpleadoDocumento[]

  @@index([tenantId])
  @@index([empleadoId])
}

/// Soporte privado de un colaborador (certificado bancario o soporte de un
/// estudio). El archivo vive en server/uploads/empleados-documentos/<empleadoId>/
/// con nombre aleatorio y solo se sirve por el endpoint autenticado con
/// permiso; `archivoRuta` nunca se devuelve al cliente.
model EmpleadoDocumento {
  id            String           @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String           @db.UniqueIdentifier
  empleadoId    String           @db.UniqueIdentifier
  /// CERTIFICADO_BANCARIO | SOPORTE_ESTUDIO
  tipo          String           @db.VarChar(30)
  estudioId     String?          @db.UniqueIdentifier
  archivoNombre String           @db.VarChar(255)
  archivoRuta   String           @db.VarChar(500)
  archivoMime   String           @db.VarChar(100)
  archivoTamano Int
  subidoPorId   String?          @db.UniqueIdentifier
  createdAt     DateTime         @default(now())
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  empleado      Empleado         @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudio       EmpleadoEstudio? @relation(fields: [estudioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([empleadoId])
  @@index([estudioId])
}

model HistorialSalario {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  empleadoId      String   @db.UniqueIdentifier
  fecha           DateTime @default(now())
  salarioAnterior Decimal  @db.Decimal(18, 2)
  nuevoSalario    Decimal  @db.Decimal(18, 2)
  motivo          String   @db.VarChar(255)
  empleado        Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
}

model PermisoLaboral {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String   @db.UniqueIdentifier
  empresaId      String   @db.VarChar(10)
  empleadoId     String   @db.UniqueIdentifier
  tipoPermiso    String   @db.VarChar(50)
  fechaInicio    DateTime
  fechaFin       DateTime
  dias           Int
  observaciones  String?  @db.Text
  estado         String   @default("Pendiente") @db.VarChar(20)
  fechaSolicitud DateTime @default(now())
  empleado       Empleado @relation(fields: [empleadoId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@index([tenantId])
  @@index([empleadoId])
