model FaltaStrike {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String   @db.UniqueIdentifier
  empresaId     String   @db.VarChar(10)
  empleadoId    String   @db.UniqueIdentifier
  fecha         DateTime @default(now())
  gravedad      String   @db.VarChar(20)
  motivo        String   @db.Text
  descargos     String?  @db.Text
  registradoPor String   @db.VarChar(255)
  empleado      Empleado @relation(fields: [empleadoId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@index([tenantId])
  @@index([empleadoId])
}

/// Una instalación física de un sistema biométrico (p. ej. un CrossChex.mdb
/// en un servidor Windows) que sirve marcaciones para UN tenant. El cursor
/// de sincronización (lastProcessedLogId) vive aquí y no en Tenant porque
/// Checkinout.Logid es un contador propio de esa instalación, no del tenant:
/// si mañana un tenant tiene dos sedes con dos CrossChex distintos, cada uno
/// es una fila nueva de FuenteBiometrica, sin tocar el resto del modelo.
model FuenteBiometrica {
  id                 String                        @id @default(uuid()) @db.UniqueIdentifier
  tenantId           String                        @db.UniqueIdentifier
  /// Identificador legible y único de la fuente (p. ej. "crosschex-flexipack"),
  /// usado para resolver configuración (ruta del .mdb) vía variables de
  /// entorno y para que MarcacionBiometrica.fuenteId sepa a qué instalación
  /// pertenece cada evento.
  nombre             String                        @unique @db.VarChar(50)
  proveedor          String                        @default("anviz") @db.VarChar(30)
  /// Último Logid de Checkinout procesado con éxito. Solo avanza después de
  /// que el lote correspondiente ya quedó insertado en Postgres/SQLServer
  /// dentro de una transacción exitosa (ver crosschex.sync.service).
  lastProcessedLogId Int                           @default(0)
  activa             Boolean                       @default(true)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  tenant             Tenant                        @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  marcaciones        MarcacionBiometrica[]
  sincronizaciones   SincronizacionBiometricoLog[]
  vinculosEmpleados  EmpleadoBiometrico[]

  @@index([tenantId])
}

/// Vínculo explícito entre un usuario del sistema biométrico
/// (Userinfo.userid en CrossChex) y un Empleado de RicoSoft. Deliberadamente
/// NO se infiere de documento/nombre: el biométrico no garantiza que su
/// userid corresponda a la cédula, así que la asociación la crea un
/// administrador a mano (ver EMPLEADOS_BIOMETRICO_ASOCIAR en permissions.ts).
/// Fase 6.1: la unicidad de esta tabla se corrigió de (tenantId, proveedor)
/// a (tenantId, fuenteId) — un externalUserId es un identificador propio de
/// UNA instalación física de CrossChex (un .mdb), no de "todo lo que use el
/// proveedor anviz". Antes de este cambio, dos FuenteBiometrica del mismo
/// tenant con el mismo proveedor habrían compartido su espacio de
/// externalUserId por error. `proveedor` se conserva (denormalizado desde
/// fuente.proveedor al crear) porque el importador/sincronizador
/// (biometrico-import.service.ts, Fase 4/5) todavía filtra por él — no se
/// tocó esa consulta en la Fase 6.1 a propósito (fuera de su alcance), así
/// que sigue funcionando igual que antes en el despliegue real de hoy (una
/// sola fuente activa por tenant). La ganancia de fuenteId aplica de lleno
/// en cuanto ese servicio también filtre por fuenteId — pendiente, no
/// bloqueante mientras exista una sola fuente por tenant.
model EmpleadoBiometrico {
  id             String           @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String           @db.UniqueIdentifier
  fuenteId       String           @db.UniqueIdentifier
  empleadoId     String           @db.UniqueIdentifier
  proveedor      String           @default("anviz") @db.VarChar(30)
  /// Checkinout.userid / Userinfo.userid tal como vienen del biométrico.
  externalUserId String           @db.VarChar(50)
  activo         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  fuente         FuenteBiometrica @relation(fields: [fuenteId], references: [id])
  empleado       Empleado         @relation(fields: [empleadoId], references: [id])

  /// Un mismo externalUserId no puede apuntar a dos empleados distintos
  /// dentro de la MISMA fuente (antes era por proveedor — ver nota arriba).
  @@unique([tenantId, fuenteId, externalUserId])
  /// Un empleado no puede tener dos vínculos activos con la misma fuente
  /// (evita asociaciones duplicadas por error de captura).
  @@unique([tenantId, empleadoId, fuenteId])
  @@index([tenantId])
  @@index([fuenteId])
}

/// Evento crudo de marcación tal como lo reporta el biométrico (Checkinout).
/// Representa el evento externo, NO "asistencia" calculada: no hay aquí
/// noción de jornada, tardanza u horas trabajadas — eso es una capa
/// posterior que lee estos registros, no que los reemplaza.
model MarcacionBiometrica {
  id             String           @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String           @db.UniqueIdentifier
  fuenteId       String           @db.UniqueIdentifier
  /// Null hasta que un administrador asocie externalUserId a un Empleado
  /// (ver EmpleadoBiometrico). El evento nunca se descarta por no tener
  /// empleado — queda visible en "marcaciones sin asociar".
  empleadoId     String?          @db.UniqueIdentifier
  /// Copiado de Empleado.empresaId en el momento en que se resuelve la
  /// asociación; null mientras la marcación esté sin asociar (ver nota en
  /// FuenteBiometrica: el mapeo dispositivo→empresa no es automático).
  empresaId      String?          @db.VarChar(10)
  /// Checkinout.Logid original. Es la clave real de idempotencia (junto con
  /// fuenteId), no (empleado + hora + tipo): dos marcaciones legítimas
  /// pueden compartir empleado/hora/tipo si el reloj biométrico las separa
  /// por segundos, y el Logid nunca se repite dentro de una misma fuente.
  externalLogId  String           @db.VarChar(50)
  /// Checkinout.userid tal como vino, conservado siempre aunque ya se haya
  /// resuelto empleadoId — permite reprocesar/auditar sin volver al MDB.
  externalUserId String           @db.VarChar(50)
  /// Checkinout.CheckTime exacto, sin conversión de zona horaria de
  /// navegador. La normalización de zona horaria (America/Bogota u otra) la
  /// hace el adaptador CrossChex al mapear, de forma explícita y
  /// configurable, no aquí.
  horaMarcacion  DateTime
  /// Fecha (solo día) derivada de horaMarcacion en la zona horaria del
  /// tenant, para poder indexar/agrupar por día sin recalcular en cada query.
  fecha          DateTime         @db.Date
  /// Checkinout.CheckType original, sin alterar. 0=Entrada, 2=Break,
  /// 3=FueraTiempo según lo confirmado en CrossChex; otros valores se
  /// conservan tal cual aunque no se conozca su significado.
  checkType      Int
  /// Interpretación textual provisional de checkType (ENTRADA | BREAK |
  /// FUERATIEMPO | OTRO). Puede recalcularse a futuro sin tocar checkType.
  tipoMarcacion  String           @db.VarChar(30)
  dispositivoId  String?          @db.VarChar(50)
  workType       Int?
  attFlag        Int?
  checked        Boolean?
  exported       Boolean?
  openDoorFlag   Boolean?
  createdAt      DateTime         @default(now())
  fuente         FuenteBiometrica @relation(fields: [fuenteId], references: [id])
  empleado       Empleado?        @relation(fields: [empleadoId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  /// Garantiza idempotencia de la sincronización a nivel de base de datos,
  /// no solo en memoria: reinsertar el mismo lote no duplica filas.
  @@unique([fuenteId, externalLogId])
  @@index([tenantId, fecha])
  @@index([empleadoId, fecha])
  @@index([externalUserId, horaMarcacion])
}

/// Log de cada corrida de sincronización CrossChex → RicoSoft. Mismo rol que
/// SincronizacionSiesaLog: auditoría de qué pasó en cada corrida, y el
/// registro "EN_CURSO" sirve como lock cooperativo (ver rule 25: no permitir
/// dos sincronizaciones simultáneas de la misma fuente).
model SincronizacionBiometricoLog {
  id           String           @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String           @db.UniqueIdentifier
  fuenteId     String           @db.UniqueIdentifier
  /// EN_CURSO | COMPLETADO | FALLIDO
  estado       String           @default("EN_CURSO") @db.VarChar(20)
  iniciadoEn   DateTime         @default(now())
  finalizadoEn DateTime?
  logIdDesde   Int
  logIdHasta   Int?
  leidos       Int              @default(0)
  insertados   Int              @default(0)
  duplicados   Int              @default(0)
  sinEmpleado  Int              @default(0)
  erroresCount Int              @default(0)
  mensajeError String?          @db.Text
  fuente       FuenteBiometrica @relation(fields: [fuenteId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  /// El lock real (una sola sincronización EN_CURSO por fuenteId) NO puede
  /// expresarse aquí: Prisma no soporta índices únicos filtrados (WHERE) en
  /// su DSL. Está garantizado a nivel de base de datos por un
  /// CREATE UNIQUE INDEX ... WHERE estado = 'EN_CURSO' escrito a mano en la
  /// migración (20260907120000_biometrico_crosschex/migration.sql). Si se
  /// regenera esta migración con `prisma migrate dev`/`diff`, ese índice no
  /// se detecta como drift porque el schema no lo declara — no se debe
  /// borrar ni se debe intentar "arreglar" añadiendo un @@unique([fuenteId])
  /// sin filtro (eso bloquearía tener más de un log histórico por fuente).
  @@index([tenantId, fuenteId, estado])
}

/// Catálogo técnico global (NO por tenant): la subpartida arancelaria de 10
/// dígitos y su arancel base (Decreto 1881) son iguales para cualquier
/// empresa del grupo que importe esa mercancía, así que se mantiene una sola
/// vez en vez de duplicarse por tenant.
model ClasificacionArancelariaMatriz {
  id                    String                @id @default(uuid()) @db.UniqueIdentifier
  subpartida            String                @unique @db.VarChar(10)
  descripcion           String                @db.VarChar(500)
  tarifaArancelariaBase Decimal               @db.Decimal(9, 4)
  requiereInvima        Boolean               @default(false)
  requiereIca           Boolean               @default(false)
  decretoReferencia     String?               @db.VarChar(50)
  activo                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  items                 ItemOrdenCompraIntl[]

  @@index([activo])
}

/// Contador MONOTÓNICO del consecutivo de órdenes internacionales por tenant y
/// AÑO (serie anual: IMP-<anio>-<n>). El siguiente número efectivo es
/// max(siguienteConsecutivo, MAX(consecutivo de los códigos existentes del año
/// — incluidas órdenes anuladas/eliminadas — ) + 1): un número ya usado nunca
/// se reutiliza. Se avanza dentro de la MISMA transacción que crea la orden
/// (compare-and-set sobre esta fila; la unicidad (tenantId, anio) cubre la
/// primera creación concurrente). Ver modules/importaciones/importaciones-consecutivo.ts.
/// Cambiar de año no requiere nada: la serie nueva nace en 1 (o en el valor
/// que Configuración de negocio fije). Cascade: es metadata derivada del tenant.
model ConsecutivoImportacion {
  id                   String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId             String   @db.UniqueIdentifier
  anio                 Int
  siguienteConsecutivo Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, anio])
}

/// Orden de compra internacional. El costeo de aduana/tránsito vive en
/// LoteImportacion (una orden puede llegar en varios embarques/contenedores
/// separados), no aquí: esta entidad es el acuerdo comercial con el
/// proveedor extranjero (Incoterm, moneda, TRM pactada).
model OrdenCompraIntl {
  id                    String                     @id @default(uuid()) @db.UniqueIdentifier
  tenantId              String                     @db.UniqueIdentifier
  numeroOrden           String                     @db.VarChar(50)
  /// Fecha explícita de la orden pactada con el proveedor — antes se
  /// inferían del createdAt del registro, que puede diferir (ej. la orden
  /// se registra en el sistema días después de haberse pactado). Default
  /// "hoy" en el formulario, pero editable: es un dato del negocio, no de
  /// auditoría (createdAt sigue intacto para eso).
  fechaOrden            DateTime                   @default(now())
  /// Identificador legible del expediente (IMP-2026-041), generado al
  /// crear la orden — nunca se reutiliza aunque la orden se anule (mismo
  /// principio que numeroOrden: la unicidad real se valida en código, no a
  /// nivel de BD, para no bloquear reusar el consecutivo si algo falla a
  /// mitad de la creación). Nullable porque las órdenes creadas ANTES de
  /// esta migración no tienen uno — se muestra el id corto como fallback.
  codigo                String?                    @db.VarChar(30)
  incoterm              String                     @db.VarChar(10)
  /// Lugar pactado del Incoterm (ej. "Shanghai, China" para FOB, "Bogotá,
  /// Colombia" para DAP) — NO se infiere del país de origen ni de ningún
  /// otro campo: el lugar exacto de entrega/embarque es una decisión
  /// comercial propia que puede no coincidir con ninguno de los dos países
  /// involucrados (ej. FOB en un puerto distinto al de fabricación).
  lugarPactado          String?                    @db.VarChar(255)
  /// FK real al catálogo de Proveedor (el mismo que usan Facturas/Servicios/
  /// Solicitudes, ya con trazabilidad a Siesa vía Proveedor.siesaTerceroRowId
  /// — no se duplica esa integración aquí). Nullable a propósito: un
  /// proveedor extranjero nuevo, comprado por primera vez, puede no existir
  /// todavía en el catálogo — en ese caso solo se llena proveedorExtranjero
  /// (texto libre) y luego se sincroniza/crea el Proveedor real. Cuando SÍ
  /// se selecciona uno, proveedorExtranjero se autocompleta con su nombre.
  proveedorId           String?                    @db.UniqueIdentifier
  proveedorExtranjero   String                     @db.VarChar(255)
  /// Nombre de país validado en código contra PAISES_VALIDOS
  /// (importaciones.controller.ts) — mismo patrón que incoterm/moneda/
  /// formaPago: sin tabla propia porque es una lista de referencia estática
  /// (países no cambian), pero SÍ normalizada (nunca "china"/"CHINA"/
  /// "China" como valores distintos, a diferencia de antes).
  paisOrigen            String                     @db.VarChar(100)
  moneda                String                     @db.VarChar(3)
  /// Tasa de cambio pactada con el proveedor (antes "TRM Pactada (COP)" en
  /// UI — el nombre del campo en BD no cambia para no romper migraciones/
  /// reportes ya existentes, solo cambia el label mostrado).
  trmPactada            Decimal                    @db.Decimal(18, 4)
  /// Fecha a la que corresponde `trmPactada` — puede ser hoy (si se tomó de
  /// "TRM oficial del día") o una fecha pasada (si el proveedor pactó una
  /// tasa fija días antes). Nullable: órdenes previas a este campo no la
  /// tienen.
  tasaCambioFecha       DateTime?
  /// Oficial | Pactada | Manual — de dónde vino el valor de trmPactada.
  /// "Oficial" solo se asigna cuando el usuario usa el botón "TRM oficial
  /// del día"; nunca sobrescribe en silencio una tasa que el usuario ya
  /// haya escrito a mano (ver crearOrdenCompraIntl / frontend).
  tasaCambioFuente      String?                    @db.VarChar(20)
  valorEstimadoTotal    Decimal                    @db.Decimal(18, 2)
  /// Borrador | Confirmada | Cerrada | Anulada — "Cerrada" ahora sí es
  /// alcanzable, vía cerrarOrdenCompraIntl + evaluarCondicionesCierre
  /// (domain/importaciones/condiciones-cierre.ts). Las condiciones son
  /// configurables por diseño (no hay una regla de negocio única todavía
  /// confirmada), no un candado fijo.
  estado                String                     @default("Borrador") @db.VarChar(20)
  /// Meta interna, nunca bloqueante: sirve para el indicador "¿cuándo
  /// debería terminar?" del expediente. Editable en cualquier momento.
  fechaEstimadaCierre   DateTime?
  fechaCierre           DateTime?
  responsableId         String?                    @db.UniqueIdentifier
  /// Término/forma de pago pactada con el proveedor extranjero (ej. "Carta
  /// de crédito", "Anticipado", "Crédito 30 días") — texto libre validado en
  /// código contra un catálogo cerrado (ver FORMAS_PAGO_VALIDAS en
  /// importaciones.controller.ts), mismo patrón que incoterm/moneda.
  /// Nullable: las órdenes creadas antes de este campo no tienen valor.
  formaPago             String?                    @db.VarChar(50)
  /// Condición de pago dentro de la forma de pago elegida (ej. "50%
  /// anticipo / 50% contra BL") — texto libre corto, complementa formaPago
  /// sin necesitar un módulo de cuotas/contabilidad (eso queda fuera de
  /// alcance a propósito).
  condicionPago         String?                    @db.VarChar(255)
  /// Detalle adicional de la condición de pago (texto largo libre).
  detallePago           String?                    @db.Text
  /// Fecha en la que el negocio necesita que la mercancía llegue —
  /// persistida como dato estructurado (no texto libre en observaciones)
  /// para que automatización futura (Bandeja Inteligente, Tracking) pueda
  /// comparar contra fechaLlegadaEstimada/fechaLlegadaReal de cada lote.
  fechaRequeridaLlegada DateTime?
  observaciones         String?                    @db.Text
  eliminado             Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id])
  responsableUsuario    User?                      @relation("OrdenCompraIntlResponsable", fields: [responsableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proveedor             Proveedor?                 @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                 ItemOrdenCompraIntl[]
  lotes                 LoteImportacion[]
  historial             ImportacionHistorial[]
  actividades           ImportacionActividad[]
  novedades             ImportacionNovedad[]
  pagos                 ImportacionPago[]
  correosBandeja        ImportacionCorreo[]
  documentos            OrdenCompraIntlDocumento[]

  // Mismo motivo que en Factura: una restricción única a nivel de BD no
  // distingue órdenes anuladas/eliminadas, así que bloquearía reusar un
  // numeroOrden para siempre. La unicidad real (solo entre órdenes activas)
  // se valida en crearOrdenCompraIntl().
  @@index([tenantId, numeroOrden])
  @@index([tenantId, estado])
  @@index([proveedorId])
}

/// Línea de producto dentro de una orden de compra internacional. Existe
/// para poder calcular costo landed POR UNIDAD (CosteoImportacionDetalle se
/// liquida por ítem, no solo por lote): sin esta tabla no hay forma de saber
/// cuánto costó cada producto cuando un mismo embarque trae varios.
model ItemOrdenCompraIntl {
  id                      String                          @id @default(uuid()) @db.UniqueIdentifier
  ordenCompraId           String                          @db.UniqueIdentifier
  descripcion             String                          @db.VarChar(255)
  /// Código/referencia interna del producto (ej. de Siesa: "HUNH1024") —
  /// distinto de subpartidaArancelariaId (esa es la clasificación arancelaria
  /// para el arancel, no el código comercial del ítem). Nullable: texto
  /// libre, sin catálogo — no todo ítem tiene un código Siesa todavía.
  referencia              String?                         @db.VarChar(100)
  /// Unidad de medida de `cantidad` (ej. "KG", "TON", "SACO25KG", "UND") —
  /// validada en código contra UNIDADES_MEDIDA_VALIDAS
  /// (importaciones.controller.ts). Nullable porque los ítems creados antes
  /// de este campo no tienen valor; el formulario de creación SÍ la exige.
  unidadMedida            String?                         @db.VarChar(20)
  /// Código/referencia con el que EL PROVEEDOR identifica este ítem en su
  /// propia cotización/catálogo (puede diferir de `referencia`, que es la
  /// referencia interna/Siesa) — texto libre, para que la Bandeja
  /// Inteligente pueda cruzarlo contra la referencia que el proveedor use
  /// en sus correos/facturas futuras.
  referenciaProveedor     String?                         @db.VarChar(100)
  subpartidaArancelariaId String?                         @db.UniqueIdentifier
  cantidad                Decimal                         @db.Decimal(18, 4)
  pesoKg                  Decimal?                        @db.Decimal(18, 4)
  volumenM3               Decimal?                        @db.Decimal(18, 4)
  valorUnitarioFob        Decimal                         @db.Decimal(18, 4)
  ordenCompra             OrdenCompraIntl                 @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  subpartida              ClasificacionArancelariaMatriz? @relation(fields: [subpartidaArancelariaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costeos                 CosteoImportacionDetalle[]

  @@index([ordenCompraId])
}

/// Documento inicial adjuntado directamente a la OrdenCompraIntl (Cotización,
/// Proforma Invoice, Oferta comercial, Otros) — deliberadamente separado del
/// patrón de "archivo único por campo fijo" de ExpedienteAduanero/
/// VistoBuenoAduanero: aquí puede haber VARIOS documentos del mismo tipo (ej.
/// dos cotizaciones de distintos ítems), así que es una tabla de filas, mismo
/// espíritu que ImportacionCorreoAdjunto. El archivo físico se guarda con el
/// MISMO patrón de middleware/upload.middleware.ts (carpeta propia bajo
/// uploads/, nunca una URL pública — se sirve solo vía endpoint autenticado
/// que valida tenant). tipo es texto validado en código contra
/// TIPOS_DOCUMENTO_ORDEN_VALIDOS (importaciones.controller.ts), mismo patrón
/// que incoterm/moneda/paisOrigen. Solo asociación de archivos: no dispara
/// ninguna extracción/IA (eso es exclusivo de la Bandeja Inteligente sobre
/// ImportacionCorreoAdjunto).
model OrdenCompraIntlDocumento {
  id              String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId        String          @db.UniqueIdentifier
  ordenCompraId   String          @db.UniqueIdentifier
  tipo            String          @db.VarChar(30)
  nombreOriginal  String          @db.VarChar(255)
  mime            String          @db.VarChar(100)
  tamano          Int
  /// Ruta relativa dentro de uploads/ordenes-compra-intl/<ordenCompraId>/,
  /// nunca una URL absoluta ni pública.
  ruta            String          @db.VarChar(500)
  subidoPorNombre String?         @db.VarChar(255)
  createdAt       DateTime        @default(now())
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordenCompra     OrdenCompraIntl @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  @@index([tenantId, ordenCompraId])
}

/// Requisito específico que un proveedor de importaciones exige para
/// completar/avanzar una solicitud (ej. "Certificado de origen", "Anticipo
/// 30%", "Confirmar dimensiones") — registro de INFORMACIÓN sobre el
/// proveedor, deliberadamente separado de OrdenCompraIntl/LoteImportacion:
/// un requisito pertenece al PROVEEDOR (aplica a todas sus órdenes futuras),
/// no a una orden puntual. Referencia VIVA por diseño (decisión explícita de
/// esta fase, ver auditoría): una orden que consulta los requisitos de su
/// proveedor siempre ve los vigentes, nunca un snapshot — si mañana se debe
/// preservar el estado exacto en el momento de una orden ya creada, eso es
/// una decisión de una fase futura (workflow de cumplimiento), no de esta.
/// tipo es texto validado en código contra TIPOS_REQUISITO_VALIDOS
/// (importaciones.controller.ts) — mismo patrón que incoterm/moneda/
/// paisOrigen, sin tabla de catálogo propia porque es una lista corta y
/// estable (DOCUMENTO/ACCION/CONDICION/INFORMACION/PAGO/ESPECIFICACION).
model RequisitoProveedorImportacion {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId    String    @db.UniqueIdentifier
  proveedorId String    @db.UniqueIdentifier
  tipo        String    @db.VarChar(30)
  nombre      String    @db.VarChar(255)
  descripcion String?   @db.Text
  obligatorio Boolean   @default(true)
  activo      Boolean   @default(true)
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, proveedorId])
  @@index([tenantId])
}

/// Bandeja Inteligente de Importaciones (V1) — un correo recibido en el
/// buzón central de importaciones (ver integrations/email/email-provider.ts),
/// con su clasificación y resultado de matching.
///
/// tenantId ES NULLABLE A PROPÓSITO — decisión arquitectónica explícita de
/// esta fase: con un único buzón central (importaciones@ricol.com.co)
/// compartido por varios tenants (Ricol/Flexipack/Green Solutions), el
/// tenant de un correo NO se conoce en el momento de la ingesta, solo
/// DESPUÉS de identificar el proveedor emisor (que sí es tenant-scoped). Un
/// correo nace con tenantId=null (fase de ingesta, prisma global — nunca
/// tenantPrisma, que exige un tenant ya conocido) y se resuelve en cuanto el
/// matching de proveedor produce un candidato único. Si el proveedor nunca
/// se identifica (excepción PROVEEDOR_NO_IDENTIFICADO), tenantId puede
/// quedar null indefinidamente — ese caso solo lo puede trisar/resolver un
/// superadmin (ver requireSuperadmin en
/// importaciones-bandeja.routes.ts), nunca un usuario de un tenant
/// cualquiera. Una vez tenantId queda asignado, TODO acceso posterior pasa
/// por el control normal tenantPrisma/attachTenantPrisma, igual que
/// cualquier otro módulo.
///
/// Idempotencia real vía @@unique([messageId]) — SIN tenantId: el Message-ID
/// es único dentro de todo el buzón (es la clave natural del correo real),
/// independientemente de a qué tenant termine atribuyéndose. Reingerir el
/// mismo correo (reintento del job de ingesta, entrega duplicada) nunca crea
/// una segunda fila.
model ConfigCorreoImportaciones {
  id Int @id
  lectura Boolean
  procesamiento Boolean
  etiqueta String @db.VarChar(128)
  minutos Int
  correos Int
  adjuntos Int
}

model ImportacionCorreo {
  etiquetaPiloto String? @db.VarChar(128)
  gmailId String? @db.VarChar(128)
  id                  String                     @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String?                    @db.UniqueIdentifier
  /// Message-ID real del proveedor de correo (RFC 5322/Gmail id) — clave de
  /// idempotencia (única por sí sola, ver comentario del modelo).
  messageId           String                     @db.VarChar(255)
  remitente           String                     @db.VarChar(320)
  destinatarios       String                     @db.Text
  asunto              String                     @db.VarChar(500)
  fechaRecibido       DateTime
  cuerpoTexto         String?                    @db.Text
  /// PENDIENTE | CLASIFICADO | EXTRAIDO | MATCHEADO | REQUIERE_REVISION |
  /// RESUELTO | ERROR — validado en código (ver
  /// ESTADOS_CORREO_VALIDOS en importaciones-bandeja.controller.ts), mismo
  /// patrón que OrdenCompraIntl.estado.
  estadoProcesamiento String                     @default("PENDIENTE") @db.VarChar(30)
  /// Clasificación determinística/IA del correo — ver
  /// TIPOS_CLASIFICACION_VALIDOS. Null hasta que el job de procesamiento lo
  /// clasifique.
  clasificacion       String?                    @db.VarChar(30)
  proveedorId         String?                    @db.UniqueIdentifier
  ordenCompraId       String?                    @db.UniqueIdentifier
  /// Errores de procesamiento (parseo, extracción, matching) — texto plano,
  /// nunca contenido comercial del correo (ver auditoría, privacidad de IA).
  ultimoError         String?                    @db.Text
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  tenant              Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proveedor           Proveedor?                 @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordenCompra         OrdenCompraIntl?           @relation(fields: [ordenCompraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adjuntos            ImportacionCorreoAdjunto[]
  excepciones         ImportacionExcepcion[]

  @@unique([messageId])
  @@index([tenantId, estadoProcesamiento])
  @@index([tenantId, proveedorId])
  @@index([tenantId, ordenCompraId])
  @@index([tenantId, fechaRecibido])
}

/// Un adjunto de un ImportacionCorreo. El archivo físico se guarda con el
/// MISMO patrón de middleware/upload.middleware.ts (carpeta propia bajo
/// uploads/, nunca una URL pública — se sirve solo vía endpoint autenticado
/// que valida tenant). hashSha256 deduplica el mismo archivo si el correo se
/// reingiere o si el proveedor reenvía el mismo adjunto en otro correo.
model ImportacionCorreoAdjunto {
  id               String                  @id @default(uuid()) @db.UniqueIdentifier
  correoId         String                  @db.UniqueIdentifier
  nombreOriginal   String                  @db.VarChar(255)
  mimeType         String                  @db.VarChar(150)
  tamano           Int
  /// Ruta relativa dentro de uploads/importaciones-correos/<correoId>/,
  /// nunca una URL absoluta ni pública.
  ruta             String                  @db.VarChar(500)
  hashSha256       String                  @db.Char(64)
  textoExtraido    String?                 @db.Text
  /// PENDIENTE | EXTRAIDO | ERROR
  estadoExtraccion String                  @default("PENDIENTE") @db.VarChar(20)
  createdAt        DateTime                @default(now())
  correo           ImportacionCorreo       @relation(fields: [correoId], references: [id], onDelete: Cascade)
  extracciones     ImportacionExtraccion[]

  @@unique([correoId, hashSha256])
  @@index([correoId])
}

/// Un dato estructurado extraído de un adjunto, con su trazabilidad completa
/// (provenance) — responde "¿de dónde salió este dato?" sin necesitar volver
/// a abrir el PDF. motorUsado documenta qué extrajo el dato (parser
/// determinístico vs. IA, y cuál) — ver
/// integrations/document-extraction/extraction-provider.ts.
model ImportacionExtraccion {
  id            String                   @id @default(uuid()) @db.UniqueIdentifier
  adjuntoId     String                   @db.UniqueIdentifier
  /// Nombre del campo extraído (ej. "eta", "incoterm", "numeroOrdenProveedor",
  /// "precioUnitarioFob") — catálogo abierto a propósito: los campos que se
  /// intentan extraer (ver §6 de la especificación) son muchos y crecerán.
  campo         String                   @db.VarChar(100)
  valorExtraido String                   @db.Text
  pagina        Int?
  motorUsado    String                   @db.VarChar(50)
  confianza     Decimal?                 @db.Decimal(5, 4)
  /// Fragmento de texto de origen que sustenta el valor extraído (ej. la
  /// línea completa del PDF donde aparece la fecha) — para poder mostrarlo
  /// en el detalle sin reabrir el archivo. Nunca se le da a la IA como
  /// instrucción, siempre como dato ya extraído (ver §7/§14).
  evidencia     String?                  @db.Text
  createdAt     DateTime                 @default(now())
  adjunto       ImportacionCorreoAdjunto @relation(fields: [adjuntoId], references: [id], onDelete: Cascade)

  @@index([adjuntoId])
  @@index([adjuntoId, campo])
}

/// Un caso que la Bandeja Inteligente no pudo resolver sola (ambigüedad,
/// inconsistencia, requisito faltante) y requiere revisión humana. Se
/// proyecta automáticamente a InboxItem (lib/inbox.ts, ya existente, sin
/// duplicar el motor de destinatarios) — esta tabla es el registro de
/// negocio persistente, InboxItem es la tarea operativa derivada.
/// tenantId es nullable por el MISMO motivo que en ImportacionCorreo: una
/// excepción PROVEEDOR_NO_IDENTIFICADO nace, por definición, sin tenant
/// resuelto (no se pudo identificar NINGÚN proveedor, y por tanto tampoco a
/// qué empresa pertenece el correo). Ese caso concreto solo lo puede ver y
/// resolver un superadmin (requireSuperadmin), nunca un usuario normal de
/// un tenant — el resto de tipos de excepción SIEMPRE tienen tenantId
/// (el proveedor ya se identificó, solo falta la orden/producto/requisito).
model ImportacionExcepcion {
  id            String            @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String?           @db.UniqueIdentifier
  correoId      String            @db.UniqueIdentifier
  /// PROVEEDOR_NO_IDENTIFICADO | ORDEN_NO_IDENTIFICADA | REQUISITO_FALTANTE |
  /// INCONSISTENCIA_VALOR | PRODUCTO_NO_IDENTIFICADO |
  /// DOCUMENTO_NO_IDENTIFICADO | OTRO
  tipo          String            @db.VarChar(40)
  descripcion   String            @db.Text
  /// Candidatos cuando la excepción es de ambigüedad (ej. varios
  /// Proveedor/OrdenCompraIntl posibles) — JSON de ids+etiquetas, para que
  /// el frontend los muestre sin tener que volver a ejecutar el matching.
  candidatos    String?           @db.Text
  /// ABIERTA | RESUELTA | DESCARTADA
  estado        String            @default("ABIERTA") @db.VarChar(20)
  resueltoPorId String?           @db.UniqueIdentifier
  resueltoEn    DateTime?
  createdAt     DateTime          @default(now())
  tenant        Tenant?           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  correo        ImportacionCorreo @relation(fields: [correoId], references: [id], onDelete: Cascade)
  resueltoPor   User?             @relation("ImportacionExcepcionResueltoPor", fields: [resueltoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, estado])
  @@index([correoId])
}

/// Trazabilidad de un embarque físico (BL/AWB + contenedor) desde puerto de
/// origen hasta planta. `estado` lleva los estados de tránsito
/// (En tránsito/En puerto/En inspección/Liberado pre-compra/Nacionalizado);
/// el estado de la OrdenCompraIntl es independiente porque una sola orden
/// puede tener varios lotes en estados distintos a la vez.
model LoteImportacion {
  id                           String                     @id @default(uuid()) @db.UniqueIdentifier
  tenantId                     String                     @db.UniqueIdentifier
  ordenCompraId                String                     @db.UniqueIdentifier
  blAwb                        String                     @db.VarChar(100)
  contenedor                   String?                    @db.VarChar(50)
  precinto                     String?                    @db.VarChar(50)
  puertoOrigen                 String                     @db.VarChar(100)
  puertoDestino                String                     @db.VarChar(100)
  naviera                      String?                    @db.VarChar(255)
  fechaEmbarque                DateTime?
  /// ETA informada por el proveedor/naviera (dato comercial, viene del
  /// correo/documento) — se sigue llamando así por compatibilidad; en el
  /// tracking marítimo (§Tracking V1) es "ETA proveedor" frente a
  /// etaTrackingActual, que es la estimación en vivo del AIS.
  fechaLlegadaEstimada         DateTime?
  fechaLlegadaReal             DateTime?
  estado                       String                     @default("En tránsito") @db.VarChar(30)
  createdAt                    DateTime                   @default(now())
  /// Identificación del booking (distinto del BL/AWB, que ya existe) —
  /// llega típicamente antes que el BL en el ciclo de vida real del
  /// embarque, extraído por la Bandeja Inteligente de un correo de booking.
  booking                      String?                    @db.VarChar(100)
  forwarder                    String?                    @db.VarChar(255)
  /// Identificación del buque — IMO/MMSI son los identificadores estables
  /// que usa cualquier proveedor de tracking marítimo (AIS); el nombre solo
  /// es para mostrar en pantalla, nunca se usa para buscar (puede repetirse
  /// entre buques, IMO no).
  buqueNombre                  String?                    @db.VarChar(255)
  buqueImo                     String?                    @db.VarChar(20)
  buqueMmsi                    String?                    @db.VarChar(20)
  /// ETA calculada en vivo por el proveedor de tracking marítimo (AIS),
  /// independiente de fechaLlegadaEstimada (la que informó el proveedor
  /// comercial) — la comparación entre ambas es lo que genera la alerta de
  /// variación de ETA. Nunca se escribe automáticamente sobre
  /// fechaLlegadaEstimada: son dos datos con dueños distintos (proveedor vs
  /// AIS) que deben poder divergir y compararse.
  etaTrackingActual            DateTime?
  ultimaPosicionLat            Float?
  ultimaPosicionLon            Float?
  ultimaPosicionFecha          DateTime?
  velocidadNudos               Float?
  rumboGrados                  Float?
  /// PENDIENTE (nunca sincronizado) | ACTIVO (última sincronización con
  /// datos) | SIN_DATOS (el proveedor de tracking no encontró el buque/IMO)
  /// | ERROR (la última consulta falló — ver ultimoErrorTracking).
  estadoTracking               String                     @default("PENDIENTE") @db.VarChar(20)
  /// Nombre del adapter de MaritimeTrackingProvider que produjo el último
  /// dato (ej. "mock", "vesselfinder") — permite cambiar de proveedor sin
  /// perder trazabilidad de qué proveedor originó cada sincronización.
  proveedorTracking            String?                    @db.VarChar(50)
  ultimoErrorTracking          String?                    @db.Text
  ultimaSincronizacionTracking DateTime?
  tenant                       Tenant                     @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  ordenCompra                  OrdenCompraIntl            @relation(fields: [ordenCompraId], references: [id])
  expediente                   ExpedienteAduanero?
  costeos                      CosteoImportacionDetalle[]
  actividades                  ImportacionActividad[]
  contenedores                 ContenedorLote[]
  hitos                        LoteImportacionHito[]
  documentos                   LoteImportacionDocumento[]

  @@index([tenantId, estado])
  @@index([ordenCompraId])
}

/// Hito REAL del recorrido de un lote (embarque, llegada a puerto, inspección
/// aduanera, recepción física en planta), registrado con su ORIGEN y su
/// responsable. Existe para no usar una sola fecha (LoteImportacion.fechaLlegadaReal,
/// que solo se escribe al recibir en planta) como si fuera varios eventos
/// distintos, y para que una fecha informada por una persona nunca quede
/// reemplazada en silencio por una calculada (tracking/AIS), que vive aparte
/// en LoteImportacion.etaTrackingActual. El levante aduanero NO se repite aquí:
/// sigue siendo ExpedienteAduanero.fechaLevante (única fuente). La
/// liberación para inventario disponible NO es un hito de este modelo: no hay
/// inventario por lote ni regla de Calidad definida (ver informe de importaciones).
/// tipo se valida en código (TIPOS_HITO_LOTE, importaciones-hitos.ts), mismo
/// patrón que el resto del módulo. Una fila por (lote, tipo): corregir la
/// fecha actualiza la fila y deja el valor anterior en ImportacionHistorial
/// (append-only).
model LoteImportacionHito {
  id                  String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String          @db.UniqueIdentifier
  loteId              String          @db.UniqueIdentifier
  /// EMBARQUE_REAL | LLEGADA_PUERTO | INSPECCION_ADUANERA | RECEPCION_PLANTA
  tipo                String          @db.VarChar(30)
  fecha               DateTime
  /// Manual (lo registró una persona) | Sistema (lo derivó una acción del
  /// propio flujo, p. ej. recibir en planta). Nunca "Tracking": el tracking
  /// no escribe hitos, solo informa etaTrackingActual/eventos de contenedor.
  origen              String          @db.VarChar(20)
  nota                String?         @db.VarChar(500)
  registradoPorId     String?         @db.UniqueIdentifier
  registradoPorNombre String?         @db.VarChar(255)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  lote                LoteImportacion @relation(fields: [loteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([loteId, tipo])
  @@index([tenantId, tipo])
}

/// Documento de un lote que NO tiene columna fija en ExpedienteAduanero:
/// B/L o AWB, certificado de análisis (COA) y otros. Plural por diseño (puede
/// haber varios del mismo tipo), mismo patrón que OrdenCompraIntlDocumento: el
/// archivo vive en uploads/lotes-importacion/<loteId>/ y solo se sirve por
/// endpoint autenticado que valida tenant. tipo se valida en código contra
/// TIPOS_DOCUMENTO_LOTE. La OBLIGATORIEDAD de cada tipo no está definida (puede
/// depender de material, proveedor o país): este modelo solo guarda archivos.
model LoteImportacionDocumento {
  id              String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId        String          @db.UniqueIdentifier
  loteId          String          @db.UniqueIdentifier
  tipo            String          @db.VarChar(30)
  nombreOriginal  String          @db.VarChar(255)
  mime            String          @db.VarChar(100)
  tamano          Int
  /// Ruta relativa dentro de uploads/lotes-importacion/<loteId>/, nunca una
  /// URL absoluta ni pública.
  ruta            String          @db.VarChar(500)
  subidoPorId     String?         @db.UniqueIdentifier
  subidoPorNombre String?         @db.VarChar(255)
  createdAt       DateTime        @default(now())
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  lote            LoteImportacion @relation(fields: [loteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, loteId])
}

/// Contenedores de un lote/embarque — un lote puede tener varios (antes solo
/// se registraba uno en LoteImportacion.contenedor, que se conserva para no
/// romper datos existentes; los contenedores adicionales o con tracking
/// propio viven aquí). El tracking marítimo por contenedor es más relevante
/// operacionalmente que la posición del buque (ver Tracking Marítimo V1):
/// saber en qué evento de la naviera está cada contenedor (booking, gate-in,
/// cargado, zarpó, transbordo, arribo, descargado, entregado).
model ContenedorLote {
  id                String          @id @default(uuid()) @db.UniqueIdentifier
  loteId            String          @db.UniqueIdentifier
  numero            String          @db.VarChar(20)
  /// BOOKED | GATE_IN | LOADED | DEPARTED | TRANSSHIPMENT | ARRIVED_PORT |
  /// DISCHARGED | DELIVERED — catálogo cerrado validado en código.
  ultimoEvento      String?         @db.VarChar(30)
  ultimoEventoFecha DateTime?
  /// Historial completo de eventos como JSON array de
  /// {tipo, fecha, ubicacion} — mismo patrón que
  /// ImportacionExcepcion.candidatos/Proveedor.materialesHabituales (JSON
  /// como texto, sin tabla propia: es de solo lectura para el usuario, no
  /// se consulta ni filtra por campo individual).
  eventosJson       String?         @db.Text
  createdAt         DateTime        @default(now())
  lote              LoteImportacion @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@unique([loteId, numero])
  @@index([loteId])
}

/// Soporte documental DIAN de un lote. DIM, factura comercial y certificado
/// de origen son, por naturaleza, un solo documento cada uno (mismo patrón
/// de "archivo único" que Factura.archivo* o Pago.comprobante*). Los vistos
/// buenos NO entran aquí como columnas porque son plurales (INVIMA, ICA,
/// otros entes a la vez): viven en VistoBuenoAduanero.
model ExpedienteAduanero {
  id                      String               @id @default(uuid()) @db.UniqueIdentifier
  tenantId                String               @db.UniqueIdentifier
  loteId                  String               @unique @db.UniqueIdentifier
  numeroDIM               String?              @db.VarChar(50)
  fechaDIM                DateTime?
  dimNombre               String?              @db.VarChar(255)
  dimRuta                 String?              @db.VarChar(500)
  dimMime                 String?              @db.VarChar(100)
  dimTamano               Int?
  facturaComercialNombre  String?              @db.VarChar(255)
  facturaComercialRuta    String?              @db.VarChar(500)
  facturaComercialMime    String?              @db.VarChar(100)
  facturaComercialTamano  Int?
  certificadoOrigenTlc    String?              @db.VarChar(100)
  certificadoOrigenNombre String?              @db.VarChar(255)
  certificadoOrigenRuta   String?              @db.VarChar(500)
  certificadoOrigenMime   String?              @db.VarChar(100)
  certificadoOrigenTamano Int?
  fechaLevante            DateTime?
  estado                  String               @default("En trámite") @db.VarChar(30)
  createdAt               DateTime             @default(now())
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  lote                    LoteImportacion      @relation(fields: [loteId], references: [id])
  vistosBuenos            VistoBuenoAduanero[]

  @@index([tenantId, estado])
}

/// Un visto bueno concreto (INVIMA, ICA, u otro ente) exigido por la
/// clasificación arancelaria del ítem. Un expediente puede necesitar cero,
/// uno o varios, y cada uno tiene su propio documento y estado de
/// aprobación independiente.
model VistoBuenoAduanero {
  id            String             @id @default(uuid()) @db.UniqueIdentifier
  expedienteId  String             @db.UniqueIdentifier
  entidad       String             @db.VarChar(50)
  numero        String?            @db.VarChar(50)
  estado        String             @default("Pendiente") @db.VarChar(20)
  archivoNombre String?            @db.VarChar(255)
  archivoRuta   String?            @db.VarChar(500)
  archivoMime   String?            @db.VarChar(100)
  archivoTamano Int?
  fecha         DateTime?
  expediente    ExpedienteAduanero @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId])
}

/// Landed cost bajo NIC 2, liquidado por ítem dentro de un lote (no por lote
/// completo) para que costoUnitarioCop sea real cuando un embarque trae
/// varios productos. `esProvisional=true` es el costeo estimado que genera
/// recibirPreCompraPlanta (mercancía ya en planta, factura final pendiente);
/// liquidarCosteoImportacion agrega la fila definitiva (esProvisional=false)
/// en vez de sobrescribir, igual que Pago nunca borra sino que anula: se
/// conserva la trazabilidad de la estimación original vs. lo liquidado.
/// trmLiquidacion + diferenciaCambioCop son el registro NIC 21 de la
/// diferencia en cambio entre la TRM pactada en la orden y la TRM real al
/// nacionalizar.
model CosteoImportacionDetalle {
  id                  String              @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String              @db.UniqueIdentifier
  loteId              String              @db.UniqueIdentifier
  itemId              String              @db.UniqueIdentifier
  valorCifUsd         Decimal             @db.Decimal(18, 2)
  trmLiquidacion      Decimal             @db.Decimal(18, 4)
  valorCifCop         Decimal             @db.Decimal(18, 2)
  arancelCop          Decimal             @db.Decimal(18, 2)
  ivaTotalCop         Decimal             @db.Decimal(18, 2)
  ivaDescontableCop   Decimal             @default(0) @db.Decimal(18, 2)
  ivaCapitalizableCop Decimal             @default(0) @db.Decimal(18, 2)
  fletesNacionalesCop Decimal             @default(0) @db.Decimal(18, 2)
  agenciamientoCop    Decimal             @default(0) @db.Decimal(18, 2)
  otrosCostosCop      Decimal             @default(0) @db.Decimal(18, 2)
  diferenciaCambioCop Decimal             @default(0) @db.Decimal(18, 2)
  cantidad            Decimal             @db.Decimal(18, 4)
  costoTotalCop       Decimal             @db.Decimal(18, 2)
  costoUnitarioCop    Decimal             @db.Decimal(18, 4)
  esProvisional       Boolean             @default(true)
  /// Método con el que se prorratearon fletes nacionales, agenciamiento y
  /// otros costos entre los ítems: FOB | PESO | VOLUMEN. NULL en filas
  /// provisionales y en liquidaciones anteriores a este campo (todas se
  /// prorratearon por participación FOB). Arancel, IVA y valor CIF siguen
  /// repartiéndose por FOB siempre.
  metodoProrrateoGastos String?           @db.VarChar(10)
  fechaLiquidacion    DateTime            @default(now())
  liquidadoPorId      String?             @db.UniqueIdentifier
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  lote                LoteImportacion     @relation(fields: [loteId], references: [id], onUpdate: NoAction)
  item                ItemOrdenCompraIntl @relation(fields: [itemId], references: [id], onUpdate: NoAction)
  liquidadoPor        User?               @relation("CosteoLiquidadoPor", fields: [liquidadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, loteId])
  @@index([itemId])
}

/// Línea de tiempo de una orden de compra internacional — evolucionó de
/// "bitácora de mutaciones del sistema" a línea de EVENTOS reales del
/// expediente (acciones + comentarios libres siguen siendo válidos, ahora
/// con contexto de negocio): un comentario sigue siendo solo otra entrada
/// con accion="Comentario", sin tabla paralela. Nunca se edita ni se borra
/// una fila existente — cada evento nuevo se agrega, la línea de tiempo es
/// append-only.
model ImportacionHistorial {
  id              String          @id @default(uuid()) @db.UniqueIdentifier
  ordenCompraId   String          @db.UniqueIdentifier
  actor           String          @db.VarChar(255)
  accion          String          @db.VarChar(255)
  detalle         String?         @db.Text
  /// Sistema (generado por una mutación del controller) | Manual (evento de
  /// negocio que un usuario registra explícitamente, ej. "Proveedor
  /// confirmó producción"). Default Sistema para no romper el historial
  /// existente antes de esta migración.
  origen          String          @default("Sistema") @db.VarChar(10)
  /// Quién ejecutó/reportó el hecho en el mundo real (puede ser un tercero
  /// — "Naviera", "Proveedor" — no necesariamente el actor que hizo clic).
  responsable     String?         @db.VarChar(255)
  /// Etapa de negocio a la que pertenece este evento (Orden, Documentación,
  /// Embarque, Tránsito, Aduana, Nacionalización, Pagos, Recepción, Cierre)
  /// — texto libre validado en controller, mismo patrón que el resto del
  /// módulo (sin enum de Prisma).
  etapa           String?         @db.VarChar(30)
  evidenciaNombre String?         @db.VarChar(255)
  evidenciaRuta   String?         @db.VarChar(500)
  evidenciaMime   String?         @db.VarChar(100)
  evidenciaTamano Int?
  createdAt       DateTime        @default(now())
  ordenCompra     OrdenCompraIntl @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  @@index([ordenCompraId])
}

/// Actividad esperada del proceso de importación — el corazón del motor de
/// seguimiento. Puede pertenecer a la orden completa (ej. "Confirmar
/// orden") o a un lote específico (ej. "Enviar documentos de embarque").
/// dependeDeId modela dependencias simples (B no puede completarse si A no
/// lo está) — un grafo plano de "depende de una", no un DAG general: la
/// complejidad real del dominio de importaciones no lo necesita todavía.
model ImportacionActividad {
  id                String                 @id @default(uuid()) @db.UniqueIdentifier
  tenantId          String                 @db.UniqueIdentifier
  ordenCompraId     String                 @db.UniqueIdentifier
  loteId            String?                @db.UniqueIdentifier
  nombre            String                 @db.VarChar(255)
  /// Orden | Documentación | Embarque | Tránsito | Aduana | Nacionalización | Pagos | Recepción | Cierre
  etapa             String                 @db.VarChar(30)
  /// Interno | Proveedor | AgenciaAduana | Transportador | Naviera | Otro
  responsableTipo   String                 @db.VarChar(20)
  responsableNombre String?                @db.VarChar(255)
  fechaPlanificada  DateTime?
  fechaLimite       DateTime?
  fechaReal         DateTime?
  /// Pendiente | EnCurso | Completada | Vencida | Bloqueada | Omitida —
  /// "Vencida" se DERIVA (fechaLimite < ahora y sigue Pendiente/EnCurso),
  /// nunca se persiste como transición manual — ver
  /// domain/importaciones/motor-seguimiento.ts.
  estado            String                 @default("Pendiente") @db.VarChar(20)
  dependeDeId       String?                @db.UniqueIdentifier
  observacion       String?                @db.Text
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  ordenCompra       OrdenCompraIntl        @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  lote              LoteImportacion?       @relation(fields: [loteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dependeDe         ImportacionActividad?  @relation("ActividadDependencia", fields: [dependeDeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dependientes      ImportacionActividad[] @relation("ActividadDependencia")

  @@index([tenantId, ordenCompraId])
  @@index([tenantId, estado])
}

/// Novedad real del proceso — no un comentario. Puede generarse a mano o
/// automáticamente (automatica=true) por el motor de seguimiento; en ese
/// caso reglaOrigen identifica qué regla la generó (ej.
/// "actividad-vencida:<actividadId>") para poder sincronizar sin duplicar
/// (upsert por reglaOrigen, ver sincronizarNovedadesAutomaticas).
model ImportacionNovedad {
  id                          String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId                    String          @db.UniqueIdentifier
  ordenCompraId               String          @db.UniqueIdentifier
  /// Retraso | DocumentoFaltante | Inconsistencia | Dano | Faltante |
  /// ProblemaAduanero | ProblemaProveedor | ProblemaTransporte |
  /// ProblemaFinanciero | Bloqueo | Otro
  tipo                        String          @db.VarChar(30)
  descripcion                 String          @db.Text
  /// Interno | Externo | PorDeterminar — nunca se asume "culpa del
  /// proveedor" solo porque algo está retrasado sin evidencia suficiente
  /// (ver domain/importaciones/motor-seguimiento.ts).
  origen                      String          @default("PorDeterminar") @db.VarChar(20)
  responsable                 String?         @db.VarChar(255)
  /// Alta | Media | Baja
  prioridad                   String          @default("Media") @db.VarChar(10)
  impacto                     String?         @db.Text
  fechaDeteccion              DateTime        @default(now())
  fechaLimite                 DateTime?
  /// Abierta | EnGestion | Resuelta
  estado                      String          @default("Abierta") @db.VarChar(20)
  accionRequerida             String?         @db.VarChar(500)
  responsableResolucionId     String?         @db.UniqueIdentifier
  responsableResolucionNombre String?         @db.VarChar(255)
  fechaResolucion             DateTime?
  evidenciaNombre             String?         @db.VarChar(255)
  evidenciaRuta               String?         @db.VarChar(500)
  evidenciaMime               String?         @db.VarChar(100)
  evidenciaTamano             Int?
  automatica                  Boolean         @default(false)
  reglaOrigen                 String?         @db.VarChar(100)
  creadoPorId                 String?         @db.UniqueIdentifier
  creadoPorNombre             String?         @db.VarChar(255)
  createdAt                   DateTime        @default(now())
  tenant                      Tenant          @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  ordenCompra                 OrdenCompraIntl @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  // Idempotencia de la generación automática: nunca dos novedades abiertas
  // por la misma regla sobre la misma orden.
  @@unique([ordenCompraId, reglaOrigen])
  @@index([tenantId, ordenCompraId])
  @@index([tenantId, estado])
}

/// Obligación/pago asociado a una importación (anticipo o saldo a
/// proveedor extranjero, flete, agencia, impuestos, transporte, otros) —
/// mismo patrón que Pago sobre Factura (nunca se borra, se anula) pero
/// modelado aparte porque no existe hoy ningún pago sobre OrdenCompraIntl.
model ImportacionPago {
  id                String          @id @default(uuid()) @db.UniqueIdentifier
  tenantId          String          @db.UniqueIdentifier
  ordenCompraId     String          @db.UniqueIdentifier
  concepto          String          @db.VarChar(255)
  valor             Decimal         @db.Decimal(18, 2)
  moneda            String          @default("COP") @db.VarChar(3)
  fechaVencimiento  DateTime?
  /// Pendiente | Pagado | Anulado
  estado            String          @default("Pendiente") @db.VarChar(20)
  fechaPago         DateTime?
  responsableId     String?         @db.UniqueIdentifier
  responsableNombre String?         @db.VarChar(255)
  comprobanteNombre String?         @db.VarChar(255)
  comprobanteRuta   String?         @db.VarChar(500)
  comprobanteMime   String?         @db.VarChar(100)
  comprobanteTamano Int?
  observaciones     String?         @db.Text
  createdAt         DateTime        @default(now())
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  ordenCompra       OrdenCompraIntl @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  @@index([tenantId, ordenCompraId])
  @@index([tenantId, estado])
}

/// Clasificación funcional de ítems — metadata PROPIA de RicoSoft sobre
/// "¿en qué partes de RicoSoft debe gestionarse este ítem?" (Importación,
/// Exportación, Inventario, Producción, Comercial...). NUNCA se escribe en
/// Siesa ni se sincroniza desde ahí — es la razón de ser de este modelo: el
/// maestro de ítems sigue siendo 100% Siesa (t120_mc_items), esto es solo
/// una capa encima. Por tenant: "IMPORTACION" del tenant A y "IMPORTACION"
/// del tenant B son dos filas independientes, nunca la misma.
model ClasificacionFuncionalItem {
  id           String                      @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String                      @db.UniqueIdentifier
  /// Slug estable (IMPORTACION, EXPORTACION, ...) — nunca se usa para
  /// mostrar al usuario (eso es `nombre`), solo como identidad legible en
  /// logs/auditoría y para que el seed inicial sea idempotente.
  codigo       String                      @db.VarChar(50)
  nombre       String                      @db.VarChar(100)
  descripcion  String?                     @db.VarChar(500)
  activo       Boolean                     @default(true)
  orden        Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  asignaciones ItemClasificacionAsignada[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

/// Asignación de UN ítem de Siesa a UNA clasificación funcional — relación
/// muchos-a-muchos (un ítem puede tener varias clasificaciones a la vez).
/// `itemRowId` es el id real de Siesa (t120_mc_items.f120_rowid), MISMO
/// patrón ya usado en todo el proyecto para referenciar ítems sin catálogo
/// propio (ver ItemOrdenCompraIntl, CotizacionProveedor, DespachoLinea) —
/// nunca una FK a una tabla de productos que no existe. La sincronización
/// de Siesa nunca toca esta tabla: no hay ninguna relación entre el
/// mecanismo de sync (que solo trae Proveedores) y este modelo.
model ItemClasificacionAsignada {
  id                String                     @id @default(uuid()) @db.UniqueIdentifier
  tenantId          String                     @db.UniqueIdentifier
  itemRowId         Int
  clasificacionId   String                     @db.UniqueIdentifier
  asignadoPorId     String?                    @db.UniqueIdentifier
  asignadoPorNombre String?                    @db.VarChar(255)
  createdAt         DateTime                   @default(now())
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  clasificacion     ClasificacionFuncionalItem @relation(fields: [clasificacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Nunca dos filas para el mismo ítem+clasificación+tenant — la protección
  // real contra duplicados vive aquí, a nivel de BD, no solo en el
  // controller.
  @@unique([tenantId, itemRowId, clasificacionId])
  @@index([tenantId, itemRowId])
  @@index([tenantId, clasificacionId])
}

/// Proyección de trabajo generada AUTOMÁTICAMENTE a partir de eventos reales
/// de otros módulos (Solicitudes de Compra, Facturas, Despachos, ...) — NUNCA
/// creado manualmente por un usuario, nunca contiene lógica de negocio propia
/// y nunca reemplaza el `estado` real de la entidad origen. Es una capa de
/// DESCUBRIMIENTO ("¿qué requiere mi atención?"), no un segundo proceso: la
/// resolución de un InboxItem se dispara desde el mismo bloque de código
/// donde la entidad origen cambia su estado real (ver lib/inbox.ts), nunca a
/// mano desde este módulo. Ver auditoría "Bandeja de Entrada Global"
/// (2026-09-03) para el diseño completo — fase 9.1: solo el modelo + la
/// librería; el wire-in inicial es únicamente Solicitudes de Compra.
model InboxItem {
  id       String @id @default(uuid()) @db.UniqueIdentifier
  tenantId String @db.UniqueIdentifier

  /// Mismo catálogo de `tipo` que Notificacion.tipo (ej.
  /// "SOLICITUD_COMPRA_PENDIENTE") — no es una segunda taxonomía a mantener.
  tipo             String @db.VarChar(50)
  /// ACCION | APROBACION | REVISION | INCIDENCIA | ALERTA | SEGUIMIENTO
  categoria        String @db.VarChar(20)
  sourceModule     String @db.VarChar(50)
  sourceEntityTipo String @db.VarChar(50)
  sourceEntityId   String @db.VarChar(100)

  titulo      String  @db.VarChar(255)
  descripcion String? @db.VarChar(500)

  /// PENDIENTE | EN_PROCESO | RESUELTO — se resuelve automáticamente desde
  /// el módulo origen; no existe una acción de "descartar" en esta fase.
  status    String @default("PENDIENTE") @db.VarChar(20)
  /// CRITICA | ALTA | MEDIA | BAJA — calculada por la plataforma, no copiada
  /// del evento origen (ver lib/inbox.ts).
  prioridad String @default("MEDIA") @db.VarChar(10)

  /// Trabajo PERSONAL (ej. el solicitante que debe recibir el resultado).
  /// Mutuamente informativo con asignadoPermiso: un evento puede resolver
  /// uno, el otro, o ninguno (nunca se inventa una asignación que el módulo
  /// origen no soporte).
  asignadoUsuarioId String? @db.UniqueIdentifier
  /// Trabajo de COLA/ÁREA: cualquier usuario con este permiso lo ve (misma
  /// semántica que notificarPorPermiso ya usa hoy).
  asignadoPermiso   String? @db.VarChar(100)

  enlace String? @db.VarChar(500)

  createdAt           DateTime  @default(now())
  /// Solo se llena cuando la entidad origen tiene una fecha límite real —
  /// nunca se inventa una donde el negocio no la tiene.
  dueAt               DateTime?
  resolvedAt          DateTime?
  resolvedByUsuarioId String?   @db.UniqueIdentifier

  tenant            Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  asignadoUsuario   User?  @relation("InboxItemAsignado", fields: [asignadoUsuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedByUsuario User?  @relation("InboxItemResueltoPor", fields: [resolvedByUsuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Idempotencia real a nivel de BD: el mismo evento (mismo origen+tipo)
  // nunca crea una segunda fila — lib/inbox.ts hace upsert contra esta clave.
  @@unique([tenantId, sourceModule, sourceEntityId, tipo])
  @@index([tenantId, asignadoUsuarioId, status])
  @@index([tenantId, asignadoPermiso, status])
  @@index([tenantId, status, prioridad])
}

/// Proforma comercial (módulo Ventas) — reemplaza el llenado manual del
/// Excel "Factura Proforma", trayendo los datos del cliente desde Siesa
/// (ver leerDatosFacturacionCliente en siesa-clientes.service.ts) y
/// dejándolos editables para retenciones/novedades. Numeración propia por
/// tenant, continuando la secuencia manual anterior desde 3890. Los totales
/// (subtotal/IVA/retención/ICA/total) NUNCA se guardan — se recalculan
/// siempre desde items + los porcentajes de este encabezado, igual que las
/// fórmulas del Excel original, para que nunca queden desactualizados.
model Proforma {
  id                  String            @id @default(uuid()) @db.UniqueIdentifier
  tenantId            String            @db.UniqueIdentifier
  numero              Int
  clienteRowId        Int
  clienteNombre       String            @db.VarChar(255)
  clienteNit          String?           @db.VarChar(50)
  contacto            String?           @db.VarChar(255)
  direccion           String?           @db.VarChar(500)
  ciudad              String?           @db.VarChar(255)
  telefono            String?           @db.VarChar(50)
  formaPago           String?           @db.VarChar(100)
  fechaVencimiento    DateTime?
  vendedorNombre      String?           @db.VarChar(255)
  ocNumero            String?           @db.VarChar(100)
  documentoAlterno    String?           @db.VarChar(100)
  remisiones          String?           @db.VarChar(100)
  moneda              String            @default("PESOS") @db.VarChar(20)
  observaciones       String?           @db.Text
  aplicaRetencion     Boolean           @default(false)
  retencionPct        Decimal           @default(2.5) @db.Decimal(5, 2)
  /// Retención de IVA (Fase 2): aplica sobre el IVA de la proforma, no sobre
  /// el total bruto — ver domain/ventas/proforma-calculo.ts. Default 15,
  /// desactivada por defecto igual que las otras dos, para que las
  /// proformas ya creadas antes de este campo conserven su comportamiento.
  aplicaRetencionIva  Boolean           @default(false)
  retencionIvaPct     Decimal           @default(15) @db.Decimal(5, 2)
  aplicaIca           Boolean           @default(false)
  icaPct              Decimal           @default(0.7) @db.Decimal(5, 2)
  /// Máquina de estados: ENVIADA (default) -> ACEPTADA -> PEDIDO_CREADO;
  /// ANULADA desde ENVIADA/ACEPTADA. PEDIDO_CREADO y ANULADA son INMUTABLES
  /// (no admiten edición, aceptación ni anulación). Una proforma NO anulada
  /// bloquea una nueva proforma sobre la misma cotización de origen (ver
  /// crearProforma). Solo se puede crear un Pedido Comercial desde una
  /// ACEPTADA, y el paso a PEDIDO_CREADO es condicional (WHERE estado =
  /// 'ACEPTADA') dentro de la misma transacción que crea el pedido.
  /// (Antes de 2026-09-24 los valores eran "activa"/"anulada".)
  estado              String            @default("ENVIADA") @db.VarChar(20)
  /// Vinculación con la cotización de origen (CRM/Siesa) que dio pie a esta
  /// proforma — opcional: una proforma puede seguir creándose manualmente,
  /// sin cotización. Es solo una REFERENCIA + snapshot: los datos propios de
  /// la proforma (cliente, items, precios, etc.) ya quedaron copiados en las
  /// columnas de arriba al momento de crearla y NO cambian si la cotización
  /// cambia después en la fuente.
  cotizacionOrigen    String?           @db.VarChar(30)
  /// Identificador técnico real de la cotización en la fuente (hoy:
  /// t430_cm_pv_docto.f430_rowid en Siesa) — se revalida contra Siesa en
  /// cada creación, nunca se confía en lo que mande el frontend.
  cotizacionIdExterno String?           @db.VarChar(50)
  /// Número visible de la cotización (ej. "COT-34147"), solo para mostrar.
  cotizacionNumero    String?           @db.VarChar(50)
  /// Documento ERP asociado si existe (ej. "PDV-55365"), solo para mostrar.
  erpDocumentoNumero  String?           @db.VarChar(50)
  /// Relación interna 1→N con la Cotización propia de RicoSoft (módulo
  /// Comercial — Fase "Gestión Comercial"), independiente de las columnas
  /// cotizacionOrigen/cotizacionIdExterno/cotizacionNumero de arriba, que
  /// siguen intactas para la referencia externa (Siesa) ya validada. Nullable
  /// a propósito: una proforma sigue pudiendo crearse manualmente, sin
  /// cotización interna, exactamente igual que hoy.
  cotizacionId        String?           @db.UniqueIdentifier
  creadoPorId         String?           @db.UniqueIdentifier
  creadoPorNombre     String            @db.VarChar(255)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creadoPor           User?             @relation(fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cotizacion          Cotizacion?       @relation(fields: [cotizacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items               ProformaItem[]
  pedidosComerciales  PedidoComercial[]

  @@unique([tenantId, numero])
  @@index([tenantId, clienteRowId])
  @@index([tenantId, cotizacionIdExterno])
  @@index([tenantId, cotizacionId])
  @@index([tenantId, estado])
}

/// Línea de producto de una Proforma. itemRowId referencia el maestro de
/// ítems de Siesa cuando la línea vino del autocompletado; queda null si se
/// escribió manualmente (mismo criterio opcional que ProformaItem.referencia).
model ProformaItem {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  proformaId     String   @db.UniqueIdentifier
  orden          Int
  itemRowId      Int?
  referencia     String?  @db.VarChar(100)
  descripcion    String   @db.VarChar(500)
  /// Bodega real de Siesa (t150_mc_bodegas) elegida para esta línea —
  /// bodegaRowId es la identidad estable (leerBodegasSiesa), bodega es el
  /// nombre ya resuelto en el momento de guardar, para mostrarlo en
  /// pantalla/histórico/PDF sin depender de una segunda consulta a Siesa.
  bodegaRowId    Int?
  bodega         String?  @db.VarChar(20)
  unidadMedida   String?  @db.VarChar(20)
  cantidad       Decimal  @db.Decimal(18, 4)
  precioUnitario Decimal  @db.Decimal(18, 2)
  descuentoPct   Decimal  @default(0) @db.Decimal(5, 2)
  ivaPct         Decimal  @default(19) @db.Decimal(5, 2)
  proforma       Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
}

/// Cotización propia de RicoSoft (módulo Comercial → Gestión Comercial, fase
/// local). Independiente de la disponibilidad de Siesa: a diferencia de la
/// cotización que hoy se busca en vivo en t430_cm_pv_docto
/// (proformas.controller.ts / siesa-pedidos.service.ts), esta es una entidad
/// propia con su propio consecutivo — nunca usa el consecutivo/rowid de
/// Siesa como PK. Los campos erp* quedan preparados para la integración de
/// escritura futura (fase posterior) pero NO se usan todavía en esta fase.
/// estado: BORRADOR | ENVIADA | APROBADA | RECHAZADA | CONVERTIDA | ANULADA.
model Cotizacion {
  id                      String            @id @default(uuid()) @db.UniqueIdentifier
  tenantId                String            @db.UniqueIdentifier
  numero                  Int
  clienteRowId            Int
  clienteNombre           String            @db.VarChar(255)
  clienteNit              String?           @db.VarChar(50)
  contacto                String?           @db.VarChar(255)
  direccion               String?           @db.VarChar(500)
  ciudad                  String?           @db.VarChar(255)
  telefono                String?           @db.VarChar(50)
  vendedorNombre          String?           @db.VarChar(255)
  fecha                   DateTime          @default(now())
  fechaVencimiento        DateTime?
  estado                  String            @default("BORRADOR") @db.VarChar(20)
  moneda                  String            @default("PESOS") @db.VarChar(20)
  observaciones           String?           @db.Text
  /// Preparado para la integración Siesa de escritura (fase futura): tipo de
  /// documento ERP (ej. "CDV"), identidad técnica (rowid), número visible,
  /// y estado/última fecha de sincronización. Sin adaptador todavía: estas
  /// columnas quedan siempre null en esta fase.
  ///
  /// (tenantId, erpRowId) debe ser único cuando erpRowId no es null — un
  /// mismo CDV no puede vincularse a dos cotizaciones del mismo tenant. Igual
  /// que en PedidoComercial, NO se declara como `@@unique([tenantId,
  /// erpRowId])`: en SQL Server ese @@unique genera un UNIQUE sin filtro y
  /// SQL Server trata NULL como valor comparable, así que la SEGUNDA
  /// cotización sin vincular de un tenant ya lo violaría. La unicidad real la
  /// impone el índice filtrado `Cotizacion_tenantId_erpRowId_filtered_uq`
  /// (WHERE erpRowId IS NOT NULL), creado por SQL manual en la migración
  /// 20260923100000_cotizacion_erp_row_id_filtered_unique. Prisma reporta su
  /// violación igualmente como P2002 con `meta.target` = nombre del índice
  /// (ver asignarErpCotizacion::esViolacionIndiceUnicoErpRowId).
  erpTipoDocumento        String?           @db.VarChar(10)
  erpRowId                Int?
  erpNumero               String?           @db.VarChar(50)
  erpFechaSincronizacion  DateTime?
  erpEstadoSincronizacion String?           @db.VarChar(20)
  creadoPorId             String?           @db.UniqueIdentifier
  creadoPorNombre         String            @db.VarChar(255)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creadoPor               User?             @relation(fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                   CotizacionItem[]
  proformas               Proforma[]
  pedidos                 PedidoComercial[]

  @@unique([tenantId, numero])
  @@index([tenantId, clienteRowId])
  @@index([tenantId, estado])
  @@index([tenantId, fecha])
}

/// Línea de una Cotizacion — mismo shape que ProformaItem (referencia,
/// cantidad, precio, descuento, IVA, bodega opcional), para que
/// crear-Proforma-desde-Cotización pueda copiar 1:1 sin transformar campos.
model CotizacionItem {
  id             String     @id @default(uuid()) @db.UniqueIdentifier
  cotizacionId   String     @db.UniqueIdentifier
  orden          Int
  itemRowId      Int?
  referencia     String?    @db.VarChar(100)
  descripcion    String     @db.VarChar(500)
  bodegaRowId    Int?
  bodega         String?    @db.VarChar(20)
  unidadMedida   String?    @db.VarChar(20)
  cantidad       Decimal    @db.Decimal(18, 4)
  precioUnitario Decimal    @db.Decimal(18, 2)
  descuentoPct   Decimal    @default(0) @db.Decimal(5, 2)
  ivaPct         Decimal    @default(19) @db.Decimal(5, 2)
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
}

/// Pedido comercial propio de RicoSoft (módulo Comercial → Gestión
/// Comercial). Deliberadamente NO se llama "PDV": PDV es el documento de
/// pedido de venta en Siesa (t430_cm_pv_docto tipo PDV) — este es un
/// documento interno de RicoSoft con su propio consecutivo (PC-XXXXX),
/// preparado para relacionarse a futuro con un PDV real vía los campos erp*
/// (sin adaptador todavía, fase posterior).
/// estado: BORRADOR | CONFIRMADO | LISTO_PARA_ERP | SINCRONIZADO |
/// ERROR_SINCRONIZACION | ANULADO.
model PedidoComercial {
  id                      String                @id @default(uuid()) @db.UniqueIdentifier
  tenantId                String                @db.UniqueIdentifier
  numero                  Int
  /// Cotización interna de origen, si el pedido viene de la cadena
  /// Cotización→Proforma→Pedido. Nullable: también puede crearse
  /// directamente desde una Proforma sin cotización interna.
  cotizacionId            String?               @db.UniqueIdentifier
  /// Proforma activa de origen (ver "Crear Pedido" en el detalle de
  /// Proforma) — snapshot independiente, nunca se recalcula si la proforma
  /// cambia después.
  proformaId              String?               @db.UniqueIdentifier
  clienteRowId            Int
  clienteNombre           String                @db.VarChar(255)
  clienteNit              String?               @db.VarChar(50)
  vendedorNombre          String?               @db.VarChar(255)
  fecha                   DateTime              @default(now())
  estado                  String                @default("BORRADOR") @db.VarChar(20)
  moneda                  String                @default("PESOS") @db.VarChar(20)
  observaciones           String?               @db.Text
  /// Vínculo con el PDV real de Siesa (t430_cm_pv_docto, f430_id_tipo_docto =
  /// 'PDV') — ver modules/comercial/pedidos.controller.ts::asignarErpPedido.
  /// erpTipoDocumento vale "PDV" (nunca "CDV": ese es el tipo que usa
  /// Cotizacion, un documento distinto en la misma tabla t430). erpRowId es
  /// f430_rowid. erpEstadoSincronizacion es el estado de INTEGRACIÓN
  /// (NO_VINCULADO si erpRowId es null — no se persiste como texto, se
  /// deriva de erpRowId — | VINCULADO | ERROR_VINCULACION), deliberadamente
  /// separado del estado COMERCIAL de la columna `estado` de arriba — nunca
  /// se mezclan en la misma columna.
  ///
  /// (tenantId, erpRowId) debe ser único cuando erpRowId no es null — un
  /// mismo PDV no puede vincularse a dos pedidos del mismo tenant. Esto NO
  /// se expresa aquí como `@@unique([tenantId, erpRowId])` a propósito:
  /// Prisma Schema Language no puede representar un índice único FILTRADO
  /// (WHERE erpRowId IS NOT NULL) para SQL Server, y un `@@unique` sin
  /// filtro rompería con el segundo pedido sin vincular de cualquier tenant
  /// (SQL Server trata NULL como valor comparable en un índice único
  /// compuesto, a diferencia de PostgreSQL). La unicidad real la impone el
  /// índice `PedidoComercial_tenantId_erpRowId_filtered_uq`, administrado
  /// por SQL manual en la migración
  /// 20260922100000_pedido_comercial_erp_row_id_filtered_unique — no existe
  /// como `@@unique` en este schema, así que Prisma no lo conoce como
  /// constraint declarado. Verificado empíricamente (Prisma 5.22.0 + SQL
  /// Server, microaudit 2026-09-22): esto NO impide que Prisma reporte su
  /// violación como P2002/PrismaClientKnownRequestError — el motor mapea
  /// cualquier violación de índice único del driver (incluida esta, no
  /// declarada) a P2002, con `meta.target` nombrando el índice real. El
  /// controller (asignarErpPedido::esViolacionIndiceUnicoErpRowId) usa esto
  /// para distinguir esta violación de cualquier otra. Este comportamiento
  /// es del motor de Prisma sobre errores nativos del driver, no una
  /// garantía documentada de forma estable entre versiones — debe
  /// revalidarse si se actualiza Prisma o el driver de SQL Server.
  erpTipoDocumento        String?               @db.VarChar(10)
  erpRowId                Int?
  erpNumero               String?               @db.VarChar(50)
  erpFechaSincronizacion  DateTime?
  erpEstadoSincronizacion String?               @db.VarChar(20)
  creadoPorId             String?               @db.UniqueIdentifier
  creadoPorNombre         String                @db.VarChar(255)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cotizacion              Cotizacion?           @relation(fields: [cotizacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proforma                Proforma?             @relation(fields: [proformaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creadoPor               User?                 @relation(fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                   PedidoComercialItem[]

  @@unique([tenantId, numero])
  @@index([tenantId, clienteRowId])
  @@index([tenantId, estado])
  @@index([tenantId, fecha])
  @@index([cotizacionId])
  @@index([proformaId])
  // Máximo UN PedidoComercial por Proforma: lo impone el índice único FILTRADO
  // PedidoComercial_tenantId_proformaId_filtered_uq (WHERE proformaId IS NOT
  // NULL), creado por SQL manual en la migración
  // 20260924100000_proforma_maquina_estados_pedido_consecutivo — no se declara
  // como @@unique (Prisma no expresa índices filtrados en SQL Server y un
  // @@unique plano rompería con los pedidos sin proforma, NULL = NULL).
}

/// Línea de un PedidoComercial — mismo shape que ProformaItem/CotizacionItem.
model PedidoComercialItem {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  pedidoId       String          @db.UniqueIdentifier
  orden          Int
  itemRowId      Int?
  referencia     String?         @db.VarChar(100)
  descripcion    String          @db.VarChar(500)
  bodegaRowId    Int?
  bodega         String?         @db.VarChar(20)
  unidadMedida   String?         @db.VarChar(20)
  cantidad       Decimal         @db.Decimal(18, 4)
  precioUnitario Decimal         @db.Decimal(18, 2)
  descuentoPct   Decimal         @default(0) @db.Decimal(5, 2)
  ivaPct         Decimal         @default(19) @db.Decimal(5, 2)
  pedido         PedidoComercial @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}
