# Copia este archivo como ".env" en server/ y completa los valores reales.
# NUNCA versiones ".env" en git (ya está en .gitignore) — este archivo
# ".env.example" es solo documentación, no debe contener credenciales reales.

# =============================================================================
# Base de datos (Prisma / SQL Server interno del tenant)
# =============================================================================

# Cadena de conexión de Prisma a la base de datos SaaS interna (SQL Server).
# En este despliegue la base vive en la LAN de la oficina; si te conectas
# remotamente, hazlo vía Tailscale hacia la IP de esa máquina.
DATABASE_URL="sqlserver://HOST:1433;database=NOMBRE_BASE_DATOS;user=USUARIO;password=CONTRASENA;encrypt=false;trustServerCertificate=true;connectionLimit=20;poolTimeout=30"

# =============================================================================
# Autenticación
# =============================================================================

# Secreto usado para firmar/verificar los JWT de sesión. Genera uno único por
# entorno (por ejemplo con `openssl rand -hex 48`) y nunca lo reutilices entre
# entornos ni lo compartas.
JWT_SECRET="GENERA_UN_SECRETO_ALEATORIO_LARGO_UNICO_PARA_ESTE_ENTORNO"

# Verificación del correo en el autoregistro (código de 6 dígitos enviado al
# correo). Déjalo en "false" hasta que haya un proveedor de correo saliente
# configurado (lib/correo-saliente.ts): con "true" y sin proveedor, el registro
# se rechaza para no crear cuentas que nadie puede verificar.
REGISTRO_VERIFICACION_CORREO_ENABLED=false

# Envío de correo saliente con la Gmail API (scope gmail.send, cuenta de servicio
# con Domain-Wide Delegation). Credencial APARTE de la de la Bandeja de
# Importaciones (gmail.readonly). El JSON es un secreto: solo en server/.env del
# servidor, nunca en el repositorio.
# Buzón REAL de Workspace que se impersona (el principal):
CORREO_SALIENTE_MAILBOX=
# Remitente visible (alias del buzón anterior); si se omite se usa el buzón:
CORREO_SALIENTE_FROM=
# JSON completo de la cuenta de servicio, en una sola línea:
CORREO_SALIENTE_SERVICE_ACCOUNT_JSON=

# =============================================================================
# Servidor HTTP
# =============================================================================

# Puerto en el que escucha el backend Express.
PORT=4000

# Entorno de ejecución (development | production | test). Afecta logging y
# validaciones estrictas (p. ej. CORS_ORIGIN obligatorio en producción).
NODE_ENV=development

# =============================================================================
# CORS
# =============================================================================

# Orígenes permitidos separados por coma (sin espacios), p. ej.
# "https://app.ricol.com.co,https://otra-app.ricol.com.co". Obligatorio en
# producción; si se omite en desarrollo, no se restringe el origen.
CORS_ORIGIN=

# =============================================================================
# Integración Siesa (UnoEE) — conexión de solo lectura a la base transaccional
# =============================================================================

# Host de la base de datos SQL Server de Siesa. Vive detrás de un túnel/VPN;
# solo es alcanzable desde una máquina con esa conectividad activa.
SIESA_DB_HOST=HOST_SIESA
SIESA_DB_PORT=1433
SIESA_DB_NAME=NOMBRE_BASE_SIESA
SIESA_DB_USER=USUARIO_SIESA
SIESA_DB_PASSWORD=CONTRASENA_SIESA

# =============================================================================
# CrossChex / Anviz (biométrico, adaptador ODBC vía .mdb)
# =============================================================================

# Ruta absoluta al archivo CrossChex.mdb en el servidor Windows donde corre
# CrossChex Standard, p. ej.
# C:\Program Files (x86)\Anviz\CrossChex Standard\DB\CrossChex.mdb
CROSSCHEX_MDB_PATH=

# Nombre exacto del driver ODBC de Access instalado en esta máquina. Si se
# omite, usa por defecto "Microsoft Access Driver (*.mdb, *.accdb)".
CROSSCHEX_ODBC_DRIVER=

# Segundos de espera al abrir la conexión ODBC antes de abortar (por defecto 15).
CROSSCHEX_CONNECT_TIMEOUT_SECONDS=15

# Milisegundos de espera por consulta antes de abortar (por defecto 30000).
CROSSCHEX_QUERY_TIMEOUT_MS=30000

# Habilita/deshabilita el scheduler de sincronización periódica CrossChex.
# Déjalo en "false" si esta máquina no tiene CrossChex instalado.
CROSSCHEX_SYNC_ENABLED=false

# Expresión cron (node-cron) para la sincronización periódica CrossChex.
CROSSCHEX_SYNC_CRON=* * * * *

# Cantidad máxima de registros procesados por corrida de sincronización.
CROSSCHEX_SYNC_BATCH_SIZE=1000

# Minutos sin sincronización exitosa antes de considerar "obsoleta" la última corrida.
CROSSCHEX_SYNC_STALE_MINUTES=15

# =============================================================================
# Importaciones — ingesta de correos (Google Workspace / Gmail API)
# =============================================================================

# Habilita/deshabilita el scheduler de ingesta de correos del buzón de importaciones.
IMPORTACIONES_EMAIL_SYNC_ENABLED=false

# Dirección del buzón a impersonar, p. ej. "importaciones@ricol.com.co".
# Requiere Domain-Wide Delegation configurada en el Admin Console de Google
# Workspace para el client_id de la cuenta de servicio (scope gmail.readonly).
IMPORTACIONES_EMAIL_MAILBOX=

# JSON completo de la cuenta de servicio de Google (el archivo descargado del
# Admin Console), como string en una sola línea. NUNCA subas el archivo .json
# al repo — solo pégalo aquí como variable de entorno.
IMPORTACIONES_EMAIL_SERVICE_ACCOUNT_JSON=

# Expresión cron (node-cron) para la ingesta periódica de correos.
IMPORTACIONES_EMAIL_SYNC_CRON=*/5 * * * *

# Máximo de correos leídos por corrida de ingesta (por defecto 25).
IMPORTACIONES_MAX_EMAILS_PER_RUN=25

# Máximo de adjuntos procesados por corrida de ingesta (por defecto 50).
IMPORTACIONES_MAX_ATTACHMENTS_PER_RUN=50

# Habilita/deshabilita el scheduler de procesamiento de correos ya ingeridos.
IMPORTACIONES_PROCESSING_ENABLED=false

# Expresión cron (node-cron) para el procesamiento periódico de correos ingeridos.
IMPORTACIONES_PROCESSING_CRON=*/5 * * * *

# =============================================================================
# Importaciones — tracking marítimo de embarques
# =============================================================================

# Habilita/deshabilita el scheduler de sincronización de tracking marítimo.
TRACKING_MARITIMO_SYNC_ENABLED=false

# Proveedor de tracking marítimo a usar. "mock" es el único adapter real en V1;
# valores futuros: VesselFinder/MarineTraffic, etc.
TRACKING_MARITIMO_PROVIDER=mock

# El adapter "mock" INVENTA posición, ETA y eventos: por defecto se bloquea tanto la
# sincronización periódica como "Sincronizar ahora". Poner en true SOLO en
# desarrollo/demos con datos de prueba; nunca con embarques reales.
TRACKING_MARITIMO_PERMITIR_SIMULADO=false

# Expresión cron (node-cron) para la sincronización periódica de tracking marítimo.
TRACKING_MARITIMO_SYNC_CRON=*/30 * * * *

# Días sin actualización exitosa antes de generar alerta de "ausencia de
# actualización" (por defecto 3).
TRACKING_MARITIMO_DIAS_SIN_ACTUALIZACION=3

# Variación de ETA en días (valor absoluto) a partir de la cual se genera
# notificación de retraso/adelanto (por defecto 1).
TRACKING_MARITIMO_UMBRAL_VARIACION_ETA_DIAS=1

# =============================================================================
# Servicios — renovaciones
# =============================================================================

# Habilita/deshabilita el scheduler de sincronización de renovaciones de servicios.
SERVICIOS_RENOVACION_SYNC_ENABLED=false

# Expresión cron (node-cron) para la sincronización periódica de renovaciones.
SERVICIOS_RENOVACION_SYNC_CRON=0 6 * * *
