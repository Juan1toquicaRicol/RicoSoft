# Copia como server/.env.integration.qa (ignorado por git) y completa las claves reales.
# Solo lo leen: test:integration:qa, db:migrate:deploy:qa, db:migrate:status:qa (scripts/qa-runner.ts),
# que ignoran cualquier DATABASE_URL del entorno y validan host, puerto, base y login por rol.
# NO modifica server/.env. Nunca "sa". Host fijo: PC-RC-SV-PR 192.168.0.234:1433 (instancia predeterminada).
# Conexión cifrada (encrypt=true). trustServerCertificate=true acepta el certificado autofirmado del servidor;
# si el servidor tiene un certificado de CA confiable, quita trustServerCertificate.
# deploy/status usan SOLO el migrador (DDL); test usa SOLO el runner (datos).
DATABASE_URL_MIGRADOR="sqlserver://192.168.0.234:1433;database=saas_dev_qa;user=saas_dev_qa_migrador;password=RicoSoftSA;encrypt=true;trustServerCertificate=true;connectionLimit=10;poolTimeout=30"
DATABASE_URL_RUNNER="sqlserver://192.168.0.234:1433;database=saas_dev_qa;user=saas_dev_qa_runner;password=RicoSoftSA;encrypt=true;trustServerCertificate=true;connectionLimit=10;poolTimeout=30"
JWT_SECRET=a6580ac95f50d279d2421593fb22aa5a3a9df8de918a3f942876e539584b08a2
RUN_DB_INTEGRATION_TESTS=true
