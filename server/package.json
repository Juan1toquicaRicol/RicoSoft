{
  "name": "server",
  "version": "1.0.0",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npx tsx watch --tsconfig ./tsconfig.json src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "catalogos:sincronizar": "tsx scripts/sincronizar-catalogos-generales.ts",
    "purgar-auditoria": "tsx scripts/purgar-auditoria.ts",
    "sync-siesa": "tsx scripts/sync-siesa.ts",
    "explore-siesa": "tsx scripts/explore-siesa.ts",
    "explore-crosschex": "tsx scripts/explore-crosschex.ts",
    "importar-historico-crosschex": "tsx scripts/importar-historico-crosschex.ts",
    "backfill-siesa-terceros": "tsx scripts/backfill-siesa-terceros.ts",
    "reporte-proveedores-duplicados": "tsx scripts/reporte-proveedores-duplicados.ts",
    "otorgar-membresia": "tsx scripts/otorgar-membresia.ts",
    "asignar-dominio-tenant": "tsx scripts/asignar-dominio-tenant.ts",
    "ci:preparar-db-integracion": "tsx scripts/ci-preparar-db-integracion.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "cd .. && eslint server",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^178.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "odbc": "^2.5.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "odbc@2.5.0": true
  }
}
